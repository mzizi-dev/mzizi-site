---
/**
 * The site shell.
 *
 * Static HTML, one stylesheet, and a generated token block. No island, no
 * framework — the doctrine that governs this ecosystem is Astro in front, Rust
 * first and TypeScript second underneath, and no third UI framework
 * (`mzizi-dev/agent-tools#82`; CHARTER.md in `mzizi-dev/mzizi`).
 *
 * `DesignTokens` is emitted for EVERY page, not just the three that render
 * registry data. This site is the design system's front door, so a landing page
 * in default Astro styling next to a component gallery in the real palette
 * would be the contradiction the whole site exists to disprove. The cost is
 * that every page's build reads the brand API — which the data pages already
 * required, so the failure mode is unchanged.
 */
import DesignTokens from "../components/DesignTokens.astro";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** Small caps label above the title. The old apex used one; it earns its place. */
  eyebrow?: string;
  lede?: string;
  /**
   * Widen the measure. Prose pages want a reading column; the pages built from
   * the registry are grids of cards and swatches and a helix diagram, and a
   * reading column crushes them into a single file of narrow boxes.
   */
  wide?: boolean;
}

const { title, description, eyebrow, lede, wide = false } = Astro.props;

// "Mzizi · Mzizi" in a browser tab is a stutter that reads as a bug, so the
// landing page gets a real document title instead of its own name twice.
const documentTitle =
  title === "Mzizi"
    ? "Mzizi — a Rust framework for the agentic web"
    : `${title} · Mzizi`;

// A reading order, not an alphabet: what this is, then the three surfaces a
// person comes here to explore, then the wider estate.
const nav = [
  { href: "/", label: "Overview" },
  { href: "/language", label: "The language" },
  { href: "/architecture", label: "Architecture" },
  { href: "/components", label: "Components" },
  { href: "/tokens", label: "Tokens" },
  { href: "/ecosystem", label: "Ecosystem" },
];

// The header is not the canonical nav — the footer is. The header's job is
// fast access to the handful of places a returning reader actually wants,
// so only three of the six routes above surface there; the rest live one
// tap away behind the mobile drawer and, in full, in the footer.
const fastNav = nav.filter((item) =>
  ["/language", "/components", "/ecosystem"].includes(item.href),
);

const footerSections = [
  {
    label: "Explore",
    links: nav,
  },
  {
    label: "For agents",
    links: [
      { href: "/llms.txt", label: "llms.txt" },
      { href: "https://mcp.mzizi.dev/mcp", label: "MCP server" },
      { href: "https://api.mzizi.dev/v1/ui", label: "Registry API" },
    ],
  },
  {
    label: "The org",
    links: [
      { href: "https://github.com/mzizi-dev", label: "github.com/mzizi-dev" },
      { href: "https://github.com/mzizi-dev/mzizi", label: "mzizi (the language)" },
      { href: "https://github.com/mzizi-dev/mzizi-registry", label: "mzizi-registry" },
    ],
  },
];

const minerals = [
  "cobalt",
  "tanzanite",
  "malachite",
  "gold",
  "terracotta",
  "sodalite",
  "copper",
];

// `build.format: "file"` emits `/ecosystem.html`; the asset server serves it
// from `/ecosystem`. Strip the extension so the current page is marked in both
// forms, and so `astro preview` highlights the same link production does.
const here = Astro.url.pathname.replace(/\.html$/, "") || "/";
const canonical = new URL(here, Astro.site ?? "https://mzizi.dev");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <!-- Agents that read HTML rather than llms.txt still get pointed at it. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <!--
      The three families the brand system names. Noto is not a style choice: it
      is picked for language coverage, because the diacritics African languages
      need are the first thing a display face drops. Every rule falls back to a
      real system stack, so a blocked font request costs the look, not the page.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Sans:wght@400;500;600;700&family=Noto+Serif:wght@600;700&display=swap"
    />

    <DesignTokens />
    <slot name="head" />
  </head>
  <body class={wide ? "wide" : undefined}>
    <a class="skip" href="#main">Skip to content</a>

    <div class="mineral-strip" aria-hidden="true">
      {minerals.map((name) => <span class={`m-${name}`} />)}
    </div>

    <header class="site-nav">
      <a class="wordmark" href="/">
        <span class="dot" aria-hidden="true" />
        mzizi
      </a>
      <nav class="site-nav-fast" aria-label="Primary">
        {
          fastNav.map((item) => (
            <a
              href={item.href}
              aria-current={here === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="sr-only">Menu</span>
        <span class="bar" aria-hidden="true" />
        <span class="bar" aria-hidden="true" />
        <span class="bar" aria-hidden="true" />
      </button>
    </header>

    <div class="drawer-backdrop" id="drawer-backdrop" hidden />
    <div
      class="mobile-drawer"
      id="mobile-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
      hidden
    >
      <div class="drawer-head">
        <a class="wordmark" href="/">
          <span class="dot" aria-hidden="true" />
          mzizi
        </a>
        <button class="drawer-close" id="drawer-close" type="button">
          <span class="sr-only">Close menu</span>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <nav class="drawer-nav" aria-label="Mobile">
        <div class="drawer-section">
          <span class="drawer-eyebrow">Explore</span>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={here === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
        <div class="drawer-section">
          <span class="drawer-eyebrow">For agents</span>
          <a href="/llms.txt">llms.txt</a>
          <a href="https://mcp.mzizi.dev/mcp">MCP server</a>
          <a href="https://api.mzizi.dev/v1/ui">Registry API</a>
        </div>
      </nav>
      <a class="drawer-cta" href="/components">Browse components</a>
    </div>

    <main id="main">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="wordmark" href="/">
              <span class="dot" aria-hidden="true" />
              mzizi
            </a>
            <p>
              Mzizi is a research project of the <strong>Bundu Foundation</strong>,
              which owns the framework, its components and its logic outright.
              nyuchi operates the design system and registry day-to-day.
              Everything public is Apache-2.0.
            </p>
            <div class="mineral-dots" aria-hidden="true">
              {minerals.map((name) => <span class={`m-${name}`} />)}
            </div>
          </div>
          {
            footerSections.map((section) => (
              <div class="footer-section">
                <span class="footer-heading">{section.label}</span>
                <ul>
                  {section.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Bundu Foundation</span>
          <div class="mineral-dots" aria-hidden="true">
            {minerals.map((name) => <span class={`m-${name}`} />)}
          </div>
        </div>
      </div>
    </footer>

    <script>
      // The header is intentionally not the full nav (see the comment above
      // `fastNav`), so small screens need a real drawer rather than the old
      // always-visible wrapping list, which is what made mobile unusable.
      const toggle = document.getElementById("nav-toggle") as HTMLButtonElement;
      const closeBtn = document.getElementById("drawer-close") as HTMLButtonElement;
      const drawer = document.getElementById("mobile-drawer") as HTMLElement;
      const backdrop = document.getElementById("drawer-backdrop") as HTMLElement;

      let lastFocused: HTMLElement | null = null;

      const focusable = () =>
        Array.from(
          drawer.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        );

      const openDrawer = () => {
        lastFocused = document.activeElement as HTMLElement;
        drawer.hidden = false;
        backdrop.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
        focusable()[0]?.focus();
        document.addEventListener("keydown", onKeydown);
      };

      const closeDrawer = () => {
        drawer.hidden = true;
        backdrop.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        document.removeEventListener("keydown", onKeydown);
        (lastFocused ?? toggle).focus();
      };

      const onKeydown = (event: KeyboardEvent) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeDrawer();
          return;
        }
        if (event.key !== "Tab") return;
        const items = focusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      toggle.addEventListener("click", () => {
        if (drawer.hidden) openDrawer();
        else closeDrawer();
      });
      closeBtn.addEventListener("click", closeDrawer);
      backdrop.addEventListener("click", closeDrawer);
      drawer.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeDrawer));
    </script>
  </body>
</html>
