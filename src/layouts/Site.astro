---
/**
 * The site shell.
 *
 * Static HTML and one stylesheet: Tailwind v4 over `@bundu/ui` (see
 * `src/styles/site.css`). Built from the package's components wherever one
 * fits: `MineralStrip`, `Icon` and `SocialIcon` in the chrome, and on inner
 * pages a `Section` band carrying the `Breadcrumb` (with its BreadcrumbList
 * JSON-LD) and a `SectionHeader`. The React primitives render to HTML at build
 * time. No page ships a framework to the browser: the doctrine is Astro in
 * front, Rust first and TypeScript second underneath, and no third UI
 * framework (`mzizi-dev/agent-tools#82`; CHARTER.md in `mzizi-dev/mzizi`).
 *
 * The landing page passes `bare` and composes its own `Hero` and sections.
 */
import MineralStrip from "@bundu/ui/MineralStrip.astro";
import Icon from "@bundu/ui/Icon.astro";
import SocialIcon from "@bundu/ui/SocialIcon.astro";
import Section from "@bundu/ui/Section.astro";
import SectionHeader from "@bundu/ui/SectionHeader.astro";
import Breadcrumb from "@bundu/ui/Breadcrumb.astro";
import { deriveBreadcrumbs } from "@bundu/ui";
import { Tooltip } from "@bundu/ui/ui/tooltip";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** Small caps label above the title. The old apex used one; it earns its place. */
  eyebrow?: string;
  lede?: string;
  /**
   * Widen the measure. Prose pages want a reading column; the pages built from
   * the registry are grids of cards and swatches and a helix diagram, and a
   * reading column crushes them into a single file of narrow boxes.
   */
  wide?: boolean;
  /** The landing page: no header band, the page composes its own hero. */
  bare?: boolean;
  /** Breadcrumb trail on inner pages (default on). Off for the 404 page. */
  breadcrumb?: boolean;
  /** Label for the trail's last crumb when the title is not the right one. */
  crumb?: string;
}

const {
  title,
  description,
  eyebrow,
  lede,
  wide = false,
  bare = false,
  breadcrumb = true,
  crumb,
} = Astro.props;

// The owner's general contact for Mzizi (2026-09-30), and the security address
// that `/.well-known/security.txt` and SECURITY.md route reports to: the one
// security contact for every repository, the console included (owner, 2026-10-03).
const CONTACT_EMAIL = "support@bundu.org";
const SECURITY_EMAIL = "security@nyuchi.com";

// "Mzizi · Mzizi" in a browser tab is a stutter that reads as a bug, so the
// landing page gets a real document title instead of its own name twice.
const documentTitle =
  title === "Mzizi"
    ? "Mzizi — a general-purpose programming language, built to make Rust better"
    : `${title} · Mzizi`;

// A reading order, not an alphabet: the language first, then the toolchain and
// the components built to support it, then the wider estate. The toolchain and
// the components are not the language (owner, 2026-09-30).
const nav = [
  { href: "/", label: "Overview" },
  { href: "/language", label: "The language" },
  { href: "/cli", label: "CLI" },
  { href: "/components", label: "Components" },
  { href: "/playground", label: "Playground" },
  { href: "/architecture", label: "Architecture" },
  { href: "/tokens", label: "Tokens" },
  { href: "/skills", label: "Skills" },
  { href: "/observability", label: "Observability" },
  { href: "/ecosystem", label: "Ecosystem" },
];

// The header is not the canonical nav — the footer is. The header's job is
// fast access to the handful of places a returning reader actually wants,
// so only three of the routes above surface there; the rest live one
// tap away behind the mobile drawer and, in full, in the footer.
const fastNav = nav.filter((item) =>
  ["/language", "/cli", "/components"].includes(item.href),
);

const footerSections = [
  {
    label: "Explore",
    links: nav,
  },
  {
    label: "For agents",
    links: [
      { href: "/llms.txt", label: "llms.txt" },
      { href: "https://mcp.mzizi.dev/mcp", label: "MCP server" },
      { href: "https://api.mzizi.dev/v1/ui", label: "Registry API" },
    ],
  },
  {
    label: "The org",
    links: [
      { href: "https://github.com/mzizi-dev", label: "github.com/mzizi-dev" },
      { href: "https://github.com/mzizi-dev/mzizi", label: "mzizi (the language)" },
      { href: "https://github.com/mzizi-dev/mzizi-registry", label: "mzizi-registry" },
    ],
  },
];

const minerals = [
  "cobalt",
  "tanzanite",
  "malachite",
  "gold",
  "terracotta",
  "sodalite",
  "copper",
];

// `build.format: "file"` emits `/ecosystem.html`; the asset server serves it
// from `/ecosystem`. Strip the extension so the current page is marked in both
// forms, and so `astro preview` highlights the same link production does.
const here = Astro.url.pathname.replace(/\.html$/, "") || "/";
const canonical = new URL(here, Astro.site ?? "https://mzizi.dev");
// What scripts/og/card.html shows, for readers who get the alt text instead.
const ogImageAlt =
  "The Mzizi Language: built to make Rust better, the way TypeScript makes JavaScript better, with a harness at its core. Apache-2.0, compiler in Rust, Phase 0 prototype. mzizi.dev";

const crumbLabels = {
  language: "The language",
  cli: "CLI",
  components: "Components",
  playground: "Playground",
  architecture: "Architecture",
  tokens: "Tokens",
  skills: "Skills",
  observability: "Observability",
  ecosystem: "Ecosystem",
};
const crumbs =
  !bare && breadcrumb && here !== "/"
    ? deriveBreadcrumbs(here, crumbLabels, "Mzizi", crumb ?? title)
    : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Mzizi" />
    <!--
      The share card, rendered from scripts/og/card.html by
      scripts/generate-og.mjs. Absolute, because link unfurlers do not resolve
      a relative og:image.
    -->
    <meta property="og:image" content={new URL("/og.png", canonical).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", canonical).href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- Agents that read HTML rather than llms.txt still get pointed at it. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <!--
      The three families the brand system names. Noto is not a style choice: it
      is picked for language coverage, because the diacritics African languages
      need are the first thing a display face drops. Every rule falls back to a
      real system stack, so a blocked font request costs the look, not the page.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Sans:wght@400;500;600;700&family=Noto+Serif:wght@600;700&display=swap"
    />

    <!--
      The tab sets render every panel into the HTML and a small script
      switches them (src/scripts/tabs.ts). With scripts off, show every panel
      and drop the tab list, which would do nothing.
    -->
    <noscript>
      <style>
        /* !important: Tailwind's preflight hides [hidden] with !important. */
        [data-slot="tabs-content"][hidden] {
          display: block !important;
        }
        [data-slot="tabs-list"] {
          display: none;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body class={wide ? "wide" : undefined}>
    <a class="skip" href="#main">Skip to content</a>

    <MineralStrip />

    <header class="site-nav">
      <a class="wordmark wordmark-lg" href="/">
        <span class="dot" aria-hidden="true" />
        Mzizi
      </a>
      <nav class="site-nav-fast" aria-label="Primary">
        {
          fastNav.map((item) => (
            <a
              href={item.href}
              aria-current={here === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="site-nav-actions">
        <button
          class="nav-toggle"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <span class="sr-only">Menu</span>
          <span class="bar" aria-hidden="true" />
          <span class="bar" aria-hidden="true" />
          <span class="bar" aria-hidden="true" />
        </button>
        <div class="icon-group">
          <Tooltip content="Search (⌘K)" side="bottom">
            <button type="button" id="search-trigger" aria-label="Search (⌘K)">
              <Icon name="search" />
            </button>
          </Tooltip>
          <Tooltip content="github.com/mzizi-dev" side="bottom">
            <SocialIcon url="https://github.com/mzizi-dev" label="GitHub" size={20} />
          </Tooltip>
          <Tooltip content="Registry API" side="bottom">
            <a href="https://api.mzizi.dev/v1/ui" aria-label="Registry API">
              <Icon name="code" />
            </a>
          </Tooltip>
        </div>
      </div>
    </header>

    <div class="search-backdrop" id="search-backdrop" hidden />
    <div
      class="search-dialog"
      id="search-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="Search"
      hidden
    >
      <div class="search-box">
        <Icon name="search" class="search-box-icon" />
        <input
          id="search-input"
          type="search"
          placeholder="Search mzizi.dev…"
          aria-label="Search mzizi.dev"
          autocomplete="off"
        />
        <button class="search-close" id="search-close" type="button">
          <span class="sr-only">Close search</span>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <ul class="search-results" id="search-results"></ul>
    </div>

    <div class="drawer-backdrop" id="drawer-backdrop" hidden />
    <div
      class="mobile-drawer"
      id="mobile-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
      hidden
    >
      <div class="drawer-head">
        <a class="wordmark" href="/">
          <span class="dot" aria-hidden="true" />
          Mzizi
        </a>
        <button class="drawer-close" id="drawer-close" type="button">
          <span class="sr-only">Close menu</span>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <nav class="drawer-nav" aria-label="Mobile">
        <div class="drawer-section">
          <span class="drawer-eyebrow">Explore</span>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={here === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
        <div class="drawer-section">
          <span class="drawer-eyebrow">For agents</span>
          <a href="/llms.txt">llms.txt</a>
          <a href="https://mcp.mzizi.dev/mcp">MCP server</a>
          <a href="https://api.mzizi.dev/v1/ui">Registry API</a>
        </div>
      </nav>
      <a class="drawer-cta" href="/components">Browse components</a>
    </div>

    <main id="main">
      {
        bare ? (
          <slot />
        ) : (
          <>
            <Section space="tight" border container={false} class="page-head">
              <div class="frame">
                {crumbs.length > 1 && (
                  <Breadcrumb items={crumbs} origin={canonical.origin} class="mb-6" />
                )}
                <SectionHeader
                  as="h1"
                  size="h1"
                  eyebrow={eyebrow}
                  title={title}
                  description={lede}
                  max="max-w-3xl"
                />
              </div>
            </Section>
            <div class="frame flow page-body">
              <slot />
            </div>
          </>
        )
      }
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="wordmark" href="/">
              <span class="dot" aria-hidden="true" />
              Mzizi
            </a>
            <p>
              <strong>Mzizi</strong> is a programming language and an independent
              research project. It owns the language, its toolchain and its
              components outright, and operates the registry day-to-day.
              Everything public is Apache-2.0.
            </p>
            <p class="footer-contact">
              Contact:{" "}
              <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Security
              reports:{" "}
              <a href={`mailto:${SECURITY_EMAIL}`}>{SECURITY_EMAIL}</a>.
            </p>
            <div class="mineral-dots" aria-hidden="true">
              {minerals.map((name) => <span class={`m-${name}`} />)}
            </div>
          </div>
          {
            footerSections.map((section) => (
              <div class="footer-section">
                <span class="footer-heading">{section.label}</span>
                <ul>
                  {section.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Bundu Foundation</span>
          <div class="footer-social">
            <SocialIcon url="https://github.com/mzizi-dev" label="Mzizi on GitHub" />
            <div class="mineral-dots" aria-hidden="true">
              {minerals.map((name) => <span class={`m-${name}`} />)}
            </div>
          </div>
        </div>
      </div>
    </footer>

    <script>
      import "../scripts/tabs.ts";
    </script>

    <script>
      // The header is intentionally not the full nav (see the comment above
      // `fastNav`), so small screens need a real drawer rather than the old
      // always-visible wrapping list, which is what made mobile unusable.
      const toggle = document.getElementById("nav-toggle") as HTMLButtonElement;
      const closeBtn = document.getElementById("drawer-close") as HTMLButtonElement;
      const drawer = document.getElementById("mobile-drawer") as HTMLElement;
      const backdrop = document.getElementById("drawer-backdrop") as HTMLElement;

      let lastFocused: HTMLElement | null = null;

      const focusable = () =>
        Array.from(
          drawer.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        );

      const openDrawer = () => {
        lastFocused = document.activeElement as HTMLElement;
        drawer.hidden = false;
        backdrop.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
        focusable()[0]?.focus();
        document.addEventListener("keydown", onKeydown);
      };

      const closeDrawer = () => {
        drawer.hidden = true;
        backdrop.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        document.removeEventListener("keydown", onKeydown);
        (lastFocused ?? toggle).focus();
      };

      const onKeydown = (event: KeyboardEvent) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closeDrawer();
          return;
        }
        if (event.key !== "Tab") return;
        const items = focusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      toggle.addEventListener("click", () => {
        if (drawer.hidden) openDrawer();
        else closeDrawer();
      });
      closeBtn.addEventListener("click", closeDrawer);
      backdrop.addEventListener("click", closeDrawer);
      drawer.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeDrawer));

      // Site search, via Pagefind — indexes the built `dist/` after `astro
      // build` (see the `postbuild` script), so `/pagefind/pagefind.js` only
      // resolves in production, never in `astro dev`.
      interface PagefindResult {
        data: () => Promise<{ url: string; excerpt: string; meta: Record<string, string> }>;
      }
      interface PagefindApi {
        init: () => Promise<void>;
        search: (query: string) => Promise<{ results: PagefindResult[] }>;
      }

      const searchTrigger = document.getElementById("search-trigger") as HTMLButtonElement;
      const searchBackdrop = document.getElementById("search-backdrop") as HTMLElement;
      const searchDialog = document.getElementById("search-dialog") as HTMLElement;
      const searchInput = document.getElementById("search-input") as HTMLInputElement;
      const searchClose = document.getElementById("search-close") as HTMLButtonElement;
      const searchResults = document.getElementById("search-results") as HTMLElement;

      let pagefind: PagefindApi | null = null;
      let lastFocusedSearch: HTMLElement | null = null;

      // Vite bundles this script for production and, even with
      // `@vite-ignore`, still wraps the dynamic import in a preload helper
      // that throws (`__VITE_PRELOAD__ is not defined`) for a path that is
      // genuinely external to its build graph. Hiding the import inside a
      // `Function` body — Pagefind's own documented workaround for
      // bundlers — keeps it out of Vite's static analysis entirely.
      const importPagefind = new Function(
        "return import('/pagefind/pagefind.js')",
      ) as () => Promise<PagefindApi>;

      async function loadPagefind(): Promise<PagefindApi> {
        if (!pagefind) {
          const mod = await importPagefind();
          await mod.init();
          pagefind = mod;
        }
        return pagefind;
      }

      const openSearch = () => {
        lastFocusedSearch = document.activeElement as HTMLElement;
        searchBackdrop.hidden = false;
        searchDialog.hidden = false;
        document.body.style.overflow = "hidden";
        searchInput.value = "";
        searchResults.innerHTML = "";
        searchInput.focus();
        void loadPagefind();
      };

      const closeSearch = () => {
        searchBackdrop.hidden = true;
        searchDialog.hidden = true;
        document.body.style.overflow = "";
        (lastFocusedSearch ?? searchTrigger).focus();
      };

      const escapeHtml = (value: string): string =>
        value.replace(
          /[&<>"']/g,
          (char) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] ?? char,
        );

      searchTrigger.addEventListener("click", openSearch);
      searchClose.addEventListener("click", closeSearch);
      searchBackdrop.addEventListener("click", closeSearch);

      document.addEventListener("keydown", (event: KeyboardEvent) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (searchDialog.hidden) openSearch();
          else closeSearch();
          return;
        }
        if (event.key === "Escape" && !searchDialog.hidden) closeSearch();
      });

      let searchDebounce: ReturnType<typeof setTimeout>;
      searchInput.addEventListener("input", () => {
        clearTimeout(searchDebounce);
        const query = searchInput.value.trim();
        if (!query) {
          searchResults.innerHTML = "";
          return;
        }
        searchDebounce = setTimeout(async () => {
          const pf = await loadPagefind();
          const { results } = await pf.search(query);
          const items = await Promise.all(results.slice(0, 8).map((r) => r.data()));
          searchResults.innerHTML = items.length
            ? items
                .map(
                  (item) => `
                <li>
                  <a href="${item.url}">
                    <span class="search-result-title">${escapeHtml(item.meta?.title ?? item.url)}</span>
                    <span class="search-result-excerpt">${item.excerpt}</span>
                  </a>
                </li>`,
                )
                .join("")
            : `<li class="search-empty">No results for “${escapeHtml(query)}”</li>`;
        }, 150);
      });
    </script>
  </body>
</html>
