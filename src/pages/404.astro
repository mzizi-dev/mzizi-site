---
import Site from "../layouts/Site.astro";

/**
 * A real 404. The Worker is configured with
 * `not_found_handling: "404-page"` rather than the single-page-application
 * rewrite, because this is a multi-page static site with no client router — an
 * unknown path that silently rendered the landing page would be a soft 404,
 * which misleads crawlers and agents far more than a plain error does.
 */
---

<Site
  title="Not found"
  description="No page at this address."
  lede="There is no page at this address."
>
  <p>
    The address may have been typed with a mistake, or the page may have moved.
    You can look for it with the search button at the top of the page, or go to
    one of these:
  </p>
  <ul>
    <li><a href="/">The front page</a></li>
    <li><a href="/components">All components, with a filter</a></li>
    <li><a href="/language">The language</a></li>
    <li><a href="/cli">The command line tools</a></li>
    <li><a href="/skills">Agent skills</a></li>
    <li><a href="/ecosystem">How the repositories fit together</a></li>
  </ul>
  <p>
    If you are an agent, <a href="/llms.txt"><code>/llms.txt</code></a> lists
    everything this site holds.
  </p>
</Site>
