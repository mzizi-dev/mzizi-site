---
import Site from "../layouts/Site.astro";

/**
 * The map. One row per public repository in `mzizi-dev`, with what it holds and
 * what it serves. Private repositories are not listed, including the one that
 * operates the MCP server — the endpoint is public and is named, the source is
 * not.
 *
 * `state` is deliberately not a marketing word. "shipping code" means the
 * repository holds a working implementation; "serving" additionally means a
 * hostname resolves to it; "placeholder" means a README and nothing else.
 * `site`, when set, is the live hostname a repository serves.
 * These were checked with `dig` and the GitHub API, not assumed.
 */
const repos = [
  {
    name: "mzizi",
    role: "The language",
    state: "shipping code, not routed",
    body: "Phase 0 of the research charter: the mz compiler front end — lexer, recovering parser, agent diagnostic protocol, content-addressed IR — nine primitives written in Mzizi itself, the four design RFCs, and the public half of the benchmark harness. Rust.",
    href: "/language",
    internal: true,
  },
  {
    name: "mzizi-registry",
    role: "Design system, registry and portal",
    state: "serving api.mzizi.dev today",
    site: "https://api.mzizi.dev/v1",
    body: "The canonical component registry for the Mzizi ecosystem, shadcn-compatible and installable with the shadcn CLI. Also the brand system, the design tokens, the DNA double helix the frontend architecture is organised around, and the registry API served at api.mzizi.dev. TypeScript, deployed as a Cloudflare Worker.",
  },
  {
    name: "mzizi-api-gateway",
    role: "The registry API",
    state: "shipping code, not routed",
    body: "Built for api.mzizi.dev — the registry API as a pure-Rust Cloudflare Worker, compiled to WASM through workers-rs. Not routed: api.mzizi.dev is served today by mzizi-registry, so this repository is the planned replacement, not the live API.",
  },
  {
    name: "mzizi-console",
    role: "The console",
    state: "serving app.mzizi.dev today",
    site: "https://app.mzizi.dev",
    body: "app.mzizi.dev — Astro renders the chrome as static HTML, Rust/Dioxus islands render the live data from the registry API. Replaces an earlier Svelte mini-app: the doctrine is one UI framework, Astro, with Rust first and TypeScript second underneath.",
  },
  {
    name: "mzizi-site",
    role: "This site",
    state: "serving mzizi.dev today",
    site: "https://mzizi.dev",
    body: "The front door and the agent-facing surfaces — llms.txt and the MCP card. Astro, static output, deployed as a Cloudflare Worker with static assets, serving the mzizi.dev apex.",
  },
  {
    name: "mzizi-docs",
    role: "Documentation",
    state: "serving docs.mzizi.dev today",
    body: "The Mintlify documentation site, live at docs.mzizi.dev (HTTP 200, checked 2026-09-27). It is the one home of Mzizi's documentation — the language, the registry, design foundations, patterns, blocks and charts.",
    site: "https://docs.mzizi.dev",
  },
  {
    name: "mzizi-roadmap",
    role: "Roadmap",
    state: "placeholder",
    body: "The Mzizi roadmap. An empty repository with a one-line README at the time of writing; the real plan of record is CHARTER.md in the language repository.",
  },
];
---

<Site
  title="Ecosystem"
  description="Every public repository in the Mzizi ecosystem: the language, the registry, the API gateway, the console, the docs, and this site — with what each one actually holds today."
  lede="Seven public repositories. Four serve a live hostname; the rest are code that is built but not routed, or a placeholder. This page says which is which."
>
  <p>
    The Mzizi ecosystem is governed by <strong>Mzizi</strong>,
    which owns the framework outright and operates the registry and
    tooling day-to-day. Everything listed here is public and Apache-2.0.
    There are private repositories in the org too — they are not listed, and
    neither is anything that is not yet real.
  </p>

  {
    repos.map((r) => (
      <div class="panel">
        <h2>
          {r.name} <span class="state">— {r.role}</span>
        </h2>
        <p>{r.body}</p>
        <p class="state">
          State: {r.state} ·{" "}
          <a href={`https://github.com/mzizi-dev/${r.name}`}>source</a>
          {r.site && (
            <>
              {" · "}
              <a href={r.site}>{new URL(r.site).host}</a>
            </>
          )}
          {r.href && (
            <>
              {" · "}
              <a href={r.href}>more on this site</a>
            </>
          )}
        </p>
      </div>
    ))
  }

  <h2>The one live agent endpoint</h2>

  <p>
    <code>https://mcp.mzizi.dev/mcp</code> is an MCP server over Streamable HTTP,
    serving the component registry as whole documents — one call returns
    everything about a component rather than several. It is gated: an
    unauthenticated request answers <code>invalid_token</code>, and signup is
    free. Its source is not public, so it has no row above.
  </p>

  <p>
    Discover its tools with the standard <code>tools/list</code> request. Any
    list of tool names written on a web page — including this one — can go
    stale, and the server is the only thing that knows what it currently
    exposes.
  </p>

  <h2>Naming</h2>

  <p>
    The Mzizi wordmark is capitalized: <code>Mzizi</code>. Every other brand
    wordmark in this ecosystem is lowercase: <code>nyuchi</code>,
    <code>mukoko</code>, <code>shamwari</code>, <code>bundu</code>,
    <code>nhimbe</code>. Package names, hostnames and code identifiers keep
    their literal spelling. <em>Mzizi</em> is Shona for root.
  </p>
</Site>
