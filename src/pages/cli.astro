---
/**
 * /cli — Mzizi on the command line, as it actually is today.
 *
 * Three things, in the order that matters to the language:
 *   1. `mz`, the compiler that implements the language. It is toolchain,
 *      not the language itself. Built from a checkout; no release.
 *   2. Installing components. React through `npx shadcn add`; Rust read from
 *      `/v1/rs`; `mzizi add` (React and Rust from `@nyuchi/mzizi-cli` 0.6.0,
 *      Astro from 0.7.0).
 *   3. `fundi`, the agent CLI in the same package.
 *
 * The owner's decision (2026-09-29): the CLI is free, with no gate. Versions
 * and crate states are read at build time and dated, never typed in here.
 */
import Site from "../layouts/Site.astro";
import RustCrates from "../components/RustCrates.astro";
import ProgramRun from "../components/ProgramRun.astro";
import { controlProgram, PROGRAMS_COMMIT } from "../lib/programs";
import {
  getComponentRecords,
  rustCrates,
  rustCrateStates,
  npmStatus,
  installCommand,
  builtAt,
  CANONICAL_BASE,
} from "../lib/registry";

const records = await getComponentRecords();
const rustCount = [...records.values()].filter((r) => r.rust).length;
// Every crate the Rust documents name, from each document's own `crate` field:
// the primitives are in `mzizi-ui`, the brand components in `mzizi-brand`, and
// a new Roots batch may land in another. Never one crate typed in for all.
const [crates, cli] = await Promise.all([
  rustCrateStates(rustCrates(records)),
  npmStatus("@nyuchi/mzizi-cli"),
]);

// `mzizi add` first shipped in @nyuchi/mzizi-cli 0.6.0. Whether the latest on
// npm is at least that is asked at build time, not assumed.
const INSTALLER_SINCE = "0.6.0";
// Semver order on the release numbers; a prerelease (`0.7.0-beta.1`) sorts
// below its own release, so it never counts as having shipped what 0.7.0 ships.
const atLeast = (version: string, floor: string) => {
  const [core, prerelease] = version.split(/-(.*)/s);
  const a = core.split(".").map(Number);
  const b = floor.split(".").map(Number);
  for (let i = 0; i < 3; i++) {
    if ((a[i] ?? 0) !== b[i]) return (a[i] ?? 0) > b[i];
  }
  return !prerelease;
};
const allPublished = crates.length > 0 && crates.every(({ status }) => status.state === "published");
// Examples for the two largest crates, read from the API: `mzizi add <component>`
// records that component's crate.
const crateExamples = crates.slice(0, 2).map(({ name, components }) => ({
  crate: name,
  component: [...components].sort()[0],
}));
const installerShipped = cli.state === "published" && atLeast(cli.version, INSTALLER_SINCE);
// `--target astro` shipped in 0.7.0: it installs a component's pure `.astro`
// from `/v1/astro/<name>`. Before that the CLI refused Astro projects.
const ASTRO_SINCE = "0.7.0";
const astroShipped = cli.state === "published" && atLeast(cli.version, ASTRO_SINCE);

const mzCommands = [
  { cmd: "mz check <file.mz>", what: "Does it compile. Human-readable diagnostics." },
  {
    cmd: "mz check --agent <file.mz>",
    what: "The same check as NDJSON: one line per real error with an exact span, a plain-language message and a fix tagged exact or guess, then a summary line.",
  },
  {
    cmd: "mz contract <file.mz>",
    what: "For a component, evaluates its contract block against its own declarations. For a service, runs it in process: each example is one request, and each ensure is tested over generated requests (tested, not proven). Exits 1 if a clause does not hold, exactly as a compile error does.",
  },
  {
    cmd: "mz fix <file.mz>",
    what: "Applies every fix tagged exact in one pass, writes the file, and re-checks it.",
  },
  { cmd: "mz outline <file.mz>", what: "The interface only, as valid Mzizi: what an agent loads instead of reading the source." },
  { cmd: "mz hash <file.mz>", what: "The root hash of the content-addressed IR, and the stored node count." },
  { cmd: "mz ir <file.mz>", what: "Every IR node with its hash and structural path." },
  {
    cmd: "mz build <file.mz> --out <dir>",
    what: "Lowers a service to a local Rust + axum package, which builds with Cargo and serves HTTP (RFC-0011 §8), or a program to a Cargo package with no dependencies (RFC-0013 §13). No component lowers yet, and there is no Workers, Containers or WebAssembly target.",
  },
  {
    cmd: "mz run [--release] <program.mz>",
    what: "Checks a program, lowers it to a Cargo package with no dependencies, builds it with cargo build --offline and runs it, exiting with its status. Errors in the file: exit 3, nothing runs. Integer overflow or division by zero: one MZ0991 line naming the .mz position, exit 101. main returning an error: MZ0992, exit 1. Needs cargo on the path and a cache directory ($MZ_CACHE_DIR, $XDG_CACHE_HOME or ~/.cache).",
  },
  {
    cmd: "mz harness version | definition [--agent] | entry <name> [--agent]",
    what: "Prints the language harness (RFC-0012): its protocol and the SHA-256 of its definition, every entry as JSON, or one entry (a type, operator, statement, command or diagnostic code, such as try or MZ0950). Exit 2 on an unknown name.",
  },
];
---

<Site
  title="CLI"
  eyebrow="Toolchain"
  description="The Mzizi toolchain on the command line: the mz compiler that implements the language, installing components (React with shadcn, Rust from /v1/rs), and the agent CLI. Free, with no gate."
  lede="The toolchain that supports the language, free with no gate. The compiler first, because it implements the language and the language is the point; then installing components; then the agent CLI."
>
  <h2 id="mz">mz, the compiler that implements the language</h2>
  <div class="prose">
    <p>
      <code>mz</code> is the binary in{" "}
      <a href="https://github.com/mzizi-dev/mzizi">mzizi-dev/mzizi</a>. There is no
      release and no published binary yet, so it is built from a checkout, with
      nothing beyond stable Rust:
    </p>
  </div>
  <code class="cmd lead">{"git clone https://github.com/mzizi-dev/mzizi.git && cd mzizi/compiler"}</code>
  <code class="cmd lead">cargo run --bin mz -- contract ../primitives/button.mz</code>

  <div class="scroller">
    <table>
      <thead>
        <tr><th>Command</th><th>What it does</th></tr>
      </thead>
      <tbody>
        {
          mzCommands.map((c) => (
            <tr>
              <td><code>{c.cmd}</code></td>
              <td>{c.what}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="prose">
    Designed but not built: <code>mz refs</code>, <code>mz path</code>,{" "}
    <code>mz patch</code>, <code>mz diff</code>, <code>mz test</code>,{" "}
    <code>mz fmt</code> and <code>mz run --agent</code> (see{" "}
    <a href="https://github.com/mzizi-dev/mzizi/blob/main/LANGUAGE-TRACKER.md"
      >what still has to be built</a
    >). More captured output is on{" "}
    <a href="/language#trying-it">the language page</a>.
  </p>

  <h3 id="mz-run"><code>mz run</code>: a program, built and run</h3>
  <div class="prose">
    <p>
      On <code>main</code> since the 8 October release
      (<a href="https://github.com/mzizi-dev/mzizi/pull/91">mzizi-dev/mzizi#91</a>).
      A program has functions, <code>let</code> and <code>var</code>,{" "}
      <code>int</code>, <code>float</code>, <code>bool</code> and{" "}
      <code>text</code>, enums, <code>else when</code>, <code>match</code>,{" "}
      <code>for each</code> over a range, <code>while</code>, and errors as
      values with <code>result</code>, <code>return error(e)</code> and{" "}
      <code>try</code>, lists, maps and sets, and records with methods (C7, C8).
      On <code>main</code> it has no modules, standard library or concurrency
      yet, and text operations are only partly built (C6). Here is the repository's{" "}
      <code>examples/control.mz</code> (FizzBuzz, <code>match</code> over an
      enum, an <code>int</code> and a <code>text</code>, loops with{" "}
      <code>break</code> and <code>continue</code>), unedited, and what{" "}
      <code>mz run</code> printed for it at <code>{PROGRAMS_COMMIT}</code>:
    </p>
  </div>
  <code class="cmd lead">cargo run --bin mz -- run ../examples/control.mz</code>
  <ProgramRun program={controlProgram} />
  <div class="prose">
    <p>
      The other example programs (<code>hello</code>, <code>fib</code>,{" "}
      <code>numbers</code>, <code>errors</code>) are in{" "}
      <a href="https://github.com/mzizi-dev/mzizi/tree/main/examples"
        ><code>examples/</code></a
      >; CI runs each one and compares its output with the committed{" "}
      <code>.expected</code> file.
    </p>
  </div>

  <h3 id="mz-harness"><code>mz harness</code>: the language harness</h3>
  <div class="prose">
    <p>
      The language harness is the spine of the language: every feature a
      program has is registered once, in <code>compiler/src/harness.rs</code>,
      and <code>mz harness</code> prints that definition for an agent to read
      (191 entries at <code>{PROGRAMS_COMMIT}</code>, 80 of them diagnostic
      codes). Tests hold the compiler and the entries together: a code with no
      entry, a trigger that stops raising its code, or an example that stops
      checking or printing its stated output fails the build. Each
      code's <code>say</code> text and each feature's teaching text are written
      by hand and not compared with the checker. A component's and a service's
      codes are not registered yet, and the plugin host is not built.
    </p>
  </div>
  <code class="cmd lead">cargo run --bin mz -- harness entry try</code>

  <h2 id="install">Installing components</h2>

  <h3>Rust (Mzizi Roots)</h3>
  <div class="prose">
    <p>
      {rustCount} components have a Rust implementation. Each one's source is
      served at:
    </p>
  </div>
  <code class="cmd lead">curl {CANONICAL_BASE}/rs/&lt;name&gt;</code>
  <div class="prose">
    <p>
      Each document names the crate its component ships in, and the crate is
      the install path, not the source. The crates the documents name today:
    </p>
  </div>
  <RustCrates crates={crates} />
  <div class="prose">
    <p>
      {!allPublished && (
        <>
          Until a crate is published, build against the source from the API or from{" "}
          <a href="https://github.com/mzizi-dev/mzizi-registry/tree/main/mzizi-rs"
            ><code>mzizi-registry/mzizi-rs</code></a
          >.
        </>
      )}
      {" "}<code>npx shadcn add</code> cannot install a Rust document: it rejects the
      schema.
    </p>
    <p>The <a href="/components#roots">Roots list</a> shows every component with a Rust implementation.</p>
  </div>

  <h3>React</h3>
  <div class="prose">
    <p>
      Every component's React (TSX) build installs with shadcn, from its absolute
      URL. Always the full URL: a bare name resolves against shadcn's own
      registry and installs a different component.
    </p>
  </div>
  <code class="cmd lead">npx shadcn@latest add <span class="flag">{CANONICAL_BASE}/ui/&lt;name&gt;</span></code>
  <p class="prose">For example: <code>{installCommand("button")}</code></p>

  <h3 id="mzizi-add"><code>mzizi add</code>: {astroShipped ? "every target" : "React and Rust"}, one command</h3>
  <div class="prose">
    <p>
      {
        installerShipped ? (
          <>
            <code>mzizi add &lt;name&gt;</code> ships in <code>@nyuchi/mzizi-cli</code>{" "}
            from <code>{INSTALLER_SINCE}</code> (latest on npm: <code>{cli.state === "published" && cli.version}</code>).
          </>
        ) : (
          <>
            <code>mzizi add &lt;name&gt;</code> ships in <code>@nyuchi/mzizi-cli</code>{" "}
            from <code>{INSTALLER_SINCE}</code>; npm could not be checked when this page was built.
          </>
        )
      }{" "}
      It detects whether a project is {astroShipped ? "React, Rust or Astro" : "React or Rust"}{" "}
      (<code>--target</code> overrides), resolves registry dependencies by absolute URL, and refuses
      what it cannot install honestly rather than guessing. No API key and no
      sign-in.
    </p>
    <ul>
      <li>
        <strong>React:</strong> writes the TSX files and names the npm
        dependencies, as <code>npx shadcn add</code> would.
      </li>
      <li>
        <strong>Rust:</strong> copies no <code>.rs</code> files, because a Roots
        component is a module of a crate, not a file to fork. It records the
        crate the component's document names
        {crateExamples.length > 0 && (
          <>
            {" "}(
            {crateExamples.map((example, i) => (
              <>
                {i > 0 && "; "}
                <code>mzizi add {example.component}</code> records <code>{example.crate}</code>
              </>
            ))}
            )
          </>
        )}{" "}
        and checks crates.io first.{" "}
        {!allPublished && (
          <>
            While a crate is unpublished, it exits 1 and says so: a Rust install
            is blocked on the crate, not on the tool.
          </>
        )}
      </li>
      <li>
        {
          astroShipped ? (
            <>
              <strong>Astro</strong> (from <code>{ASTRO_SINCE}</code>): installs the
              component's pure <code>.astro</code> from{" "}
              <code>{CANONICAL_BASE}/astro/&lt;name&gt;</code>, with every registry
              file it imports, into <code>src/components/mzizi/</code>, and refuses by
              name a component that has no <code>.astro</code> rather than install its
              TSX.
            </>
          ) : cli.state === "unknown" ? (
            <>
              <strong>Astro:</strong> <code>--target astro</code> ships from{" "}
              <code>{ASTRO_SINCE}</code>; npm could not be checked when this page was
              built, so this page cannot say whether the latest has it.
            </>
          ) : (
            <>
              <strong>Astro:</strong> <code>--target astro</code> ships from{" "}
              <code>{ASTRO_SINCE}</code>, which npm did not have when this page was
              built; earlier versions refuse an Astro project.
            </>
          )
        }
      </li>
    </ul>
  </div>
  <code class="cmd lead">npm install --save-dev @nyuchi/mzizi-cli</code>
  <code class="cmd lead">npx mzizi add button --dry-run</code>

  <h2 id="agent">The agent CLI: <code>fundi</code></h2>
  <div class="prose">
    <p>
      The same package's other binary, <code>fundi</code>, reads your project off
      disk and plans a Mzizi-aligned change against the registry and skills.{" "}
      <code>explore</code> runs offline. <code>plan</code> and <code>chat</code>{" "}
      read the MCP server; without an <code>ANTHROPIC_API_KEY</code>,{" "}
      <code>plan</code> hands its context to the coding agent that ran it instead
      of calling a model itself.
    </p>
    <p>
      The CLI is free, with no gate, and so is the MCP server it reads: nothing
      needs a sign-in except the Fundi tools (<code>mzizi_fundi</code> and{" "}
      <code>mzizi_report_issue</code>), which act as your console user.{" "}
      <code>fundi login</code> exists for those alone.
    </p>
  </div>

  <p class="provenance">
    <span>
      Rust count read from <code>{CANONICAL_BASE}/rs/&lt;name&gt;</code>; crates.io and
      npm checked when this page was built, <time datetime={builtAt}>{builtAt}</time>.
    </span>
  </p>
</Site>
