---
/**
 * /tokens — the whole palette, shown rather than listed.
 *
 * Twenty-one colour families: seven minerals, seven heritage tones, seven
 * experimental. Rendering only the seven minerals is the single most common
 * defect in this estate's token surfaces, so the count is asserted below and
 * the build fails rather than quietly shipping a partial palette.
 *
 * Both the light and the dark value of every family is painted, side by side,
 * in the colour itself: a palette page that renders only the current theme's
 * half is showing half a palette. The hex printed on each swatch is the value
 * the API served; the ink it is printed in is chosen by luminance, which is the
 * one thing on this page computed rather than fetched.
 *
 * The page ends with the registry's own `componentSpecs` rendered as real
 * pieces at their real dimensions — which is also what the rest of this site is
 * built out of, so the gallery is not a mock-up of the system, it is a labelled
 * sample of the system the page itself is wearing.
 */
import { Card } from "@bundu/ui/ui/card";
import { Badge } from "@bundu/ui/ui/badge";
import { Separator } from "@bundu/ui/ui/separator";
import Site from "../layouts/Site.astro";
import {
  getBrand,
  getSizeLayers,
  SIZE_ROLES,
  readableInk,
  builtAt,
  CANONICAL_BASE,
  type ColourFamily,
} from "../lib/registry";

const brand = await getBrand();
const layers = await getSizeLayers();
const desktop = layers.find((l) => l.id === "desktop");
const dense = layers.length > 1;

const collections = [
  {
    id: "minerals",
    title: "Seven African Minerals",
    blurb:
      "The brand palette. Every mineral is named for something mined on this continent and carries one meaning the design system spends everywhere — cobalt is knowledge, gold is value, terracotta is community.",
    families: brand.minerals,
  },
  {
    id: "heritage",
    title: "Seven Heritage tones",
    blurb:
      "Atmospheric anchors rather than brand marks. Heritage tones set mood and surface — dusk, dust, river, fire — and are drawn from craft and landscape rather than from geology.",
    families: brand.heritage,
  },
  {
    id: "experimental",
    title: "Seven Experimental",
    blurb:
      "A seven-point hue wheel under evaluation, served with its container and on-container steps but without the origin-and-symbolism prose the other fourteen carry. They are in the palette; they are not yet spoken for.",
    families: brand.experimental,
  },
];

const familyCount = collections.reduce((sum, collection) => sum + collection.families.length, 0);

// The partial-palette guard. Twenty-one families or the build stops.
if (familyCount !== 21) {
  throw new Error(
    `mzizi-site build: the brand API served ${familyCount} colour families, expected 21 ` +
      `(7 minerals, 7 heritage, 7 experimental). Refusing to render a partial palette. ` +
      `If the palette genuinely changed size, update this assertion deliberately.`,
  );
}

/** Inline custom properties for one painted swatch. No colour is invented. */
// A hex swatch gets the black or white that reads on it. A translucent rgba()
// of 50% or more is read as the colour it is (a 60% black scrim takes white
// ink); anything fainter or mixed (the tinted surfaces) sits on the page
// surface, so its label takes the page's own ink, not a guess about a colour
// that is not opaque.
const inkFor = (value: string) => {
  if (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(value)) return readableInk(value);
  const rgba = value.match(/^rgba\(\s*(\d+),\s*(\d+),\s*(\d+),\s*([\d.]+)\s*\)$/);
  if (rgba && Number(rgba[4]) >= 0.5) {
    const hex = [1, 2, 3].map((i) => Number(rgba[i]).toString(16).padStart(2, "0")).join("");
    return readableInk(`#${hex}`);
  }
  return "var(--foreground)";
};
const paint = (hex: string) => `--swatch: ${hex}; --swatch-ink: ${inkFor(hex)}`;

const hasProse = (family: ColourFamily) =>
  Boolean(family.origin || family.symbolism || family.usage);

const fonts = Object.entries(brand.typography.fonts) as [
  "sans" | "serif" | "mono",
  { family: string; usage: string; reason: string },
][];

const maxSpace = Math.max(...brand.spacing.map((step) => step.px));
// The spacing floor, exactly as the API serves it. Absent on an API pinned before
// registry 4.24.0, and then the page says so instead of inventing a value.
const acc = brand.accessibility;
const spacingFloor = (
  [
    ["Inset", acc.minInset, "px", "Padding between text and the edge of its container: a control's label on the inline axis; a card, panel, dialog, alert or popover on both axes."],
    ["Control gap", acc.minControlGap, "px", "Gap between adjacent interactive controls, visible edge to visible edge. Hit regions may touch, never overlap."],
    ["Label gap", acc.minLabelGap, "px", "Gap between a label and its field."],
    ["Item gap", acc.minItemGap, "px", "Gap between sibling items of a list, grid, stack or toolbar."],
    ["Body leading", acc.minBodyLeading, "", "Body line height, as a multiple of the font size (WCAG 1.4.12)."],
  ] as const
)
  .filter(([, value]) => typeof value === "number")
  .map(([name, value, unit, usage]) => ({
    name,
    value: unit ? `${value}${unit}` : `${value}`,
    usage,
  }));
const radii = Object.entries(brand.radii).filter(([, value]) => /^\d/.test(value));
const specs = brand.componentSpecs;
---

<Site
  title="Colour, type and space"
  eyebrow="Design tokens"
  description="The Mzizi design tokens: 21 colour families across minerals, heritage and experimental, plus the surface ladder, semantic roles, typography, spacing, radii and component specs."
  lede="The fixed ground every Mzizi component is rendered and contract-tested against. Twenty-one colour families, each with a light value and a dark one, and most with a place they came from — plus the surfaces, type, spacing and dimensions this very page is built out of."
  wide
>
  <ul class="stats">
    <li>
      <span class="stat-value">{familyCount}</span>
      <span class="stat-label">Colour families</span>
    </li>
    <li>
      <span class="stat-value">{brand.backgrounds.length}</span>
      <span class="stat-label">Surfaces</span>
    </li>
    <li>
      <span class="stat-value">{brand.semanticColors.length}</span>
      <span class="stat-label">Semantic roles</span>
    </li>
    <li>
      <span class="stat-value">{brand.typography.scale.length}</span>
      <span class="stat-label">Type steps</span>
    </li>
    <li>
      <span class="stat-value">{brand.spacing.length}</span>
      <span class="stat-label">Spacing steps</span>
    </li>
  </ul>

  <p class="provenance">
    <span>
      Read from <code>{CANONICAL_BASE}/brand</code> when this page was built,{" "}
      <time datetime={builtAt}>{builtAt}</time> — brand system v{brand.version},
      last changed {brand.lastUpdated}.
    </span>
    <a href={`${CANONICAL_BASE}/brand`}>Read the JSON</a>
  </p>

  {collections.map((collection) => (
    <section>
      <h2 id={collection.id}>{collection.title}</h2>
      <div class="prose"><p>{collection.blurb}</p></div>
      <ul class="families">
        {collection.families.map((family) => (
          <li class="family">
            <div class="pair">
              <div class="swatch" style={paint(family.lightHex)}>
                <b>Light</b>{family.lightHex}
              </div>
              <div class="swatch" style={paint(family.darkHex)}>
                <b>Dark</b>{family.darkHex}
              </div>
            </div>
            <div class="family-body">
              <h3>
                {family.name}{" "}
                <code>{family.cssVar}</code>
              </h3>
              {hasProse(family) ? (
                <dl>
                  {family.symbolism && (<><dt>Means</dt><dd>{family.symbolism}</dd></>)}
                  {family.origin && (<><dt>From</dt><dd>{family.origin}</dd></>)}
                  {family.usage && (<><dt>Used for</dt><dd>{family.usage}</dd></>)}
                </dl>
              ) : (
                <p class="count-link">No origin or symbolism recorded for this family yet.</p>
              )}
              {family.containerLight && family.containerDark && (
                <div class="pair sub">
                  <div class="swatch" style={paint(family.containerLight)}>
                    <b>Container</b>{family.containerLight}
                  </div>
                  <div class="swatch" style={paint(family.containerDark)}>
                    <b>Container</b>{family.containerDark}
                  </div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <Separator className="my-12" />

  <h2 id="surfaces">The surface ladder</h2>
  <div class="prose">
    <p>
      Ambient to elevated: what a page sits on, what a card sits on, what a menu
      floats above, and what a modal darkens behind it. This page is painted with
      these exact values — the body is <code>base</code>, every card is{" "}
      <code>surface</code>, every inset is <code>container</code>.
    </p>
  </div>
  <ul class="ladder">
    {brand.backgrounds.map((surface) => (
      <li class="ladder-item">
        <div class="pair">
          <div style={paint(surface.light)}>{surface.light}</div>
          <div style={paint(surface.dark)}>{surface.dark}</div>
        </div>
        <div class="meta">
          <strong>{surface.name}</strong>
          <span>{surface.usage}</span>
        </div>
      </li>
    ))}
  </ul>

  <h2 id="semantic">Semantic roles</h2>
  <div class="prose">
    <p>
      The roles, not the pigments. A component asks for <code>--destructive</code>{" "}
      or <code>--ring</code>; which mineral answers is a decision that lives at
      node N1 and nowhere else. The ladder below is what <code>/v1/brand</code>{" "}
      publishes, and its <code>--primary</code> is still tanzanite. The
      registry's default stylesheet, <code>mzizi-tokens-globals.css</code>,
      resolves <code>--primary</code> per brand, and its default brand is
      Mzizi, so <code>--primary</code> is{" "}
      <code>var(--heritage-hematite-aa)</code>: hematite, Mzizi's brand mineral
      by the owner's decision of 30 September 2026. This site wears hematite through{" "}
      <code>@bundu/ui</code>'s <code>brand-mzizi.css</code>, which sets both{" "}
      <code>--primary</code> and <code>--ring</code> to{" "}
      <code>--color-hematite</code>. Cobalt stays reserved for links and
      information — the palette says so itself.
    </p>
  </div>
  <ul class="ladder">
    {brand.semanticColors.map((token) => (
      <li class="ladder-item">
        <div class="pair">
          <div style={paint(token.light)}>{token.light}</div>
          <div style={paint(token.dark)}>{token.dark}</div>
        </div>
        <div class="meta">
          <strong>{token.name}</strong>
          <span>{token.usage}</span>
        </div>
      </li>
    ))}
  </ul>

  <Separator className="my-12" />

  <h2 id="typography">Typography</h2>
  <div class="prose">
    <p>
      Three families, chosen for language coverage before looks: Noto carries the
      diacritics African languages need, which a display face picked for its
      lowercase <em>g</em> does not.
    </p>
  </div>
  <ul class="ladder">
    {fonts.map(([role, font]) => (
      <li class="ladder-item">
        <div class="meta">
          <strong style={`font-family: var(--font-${role}); font-size: var(--text-h5);`}>
            {font.family}
          </strong>
          <span>{role} · {font.usage}. {font.reason}.</span>
        </div>
      </li>
    ))}
  </ul>

  <ul class="specimens">
    {brand.typography.scale.map((step) => (
      <li class="specimen">
        <span
          class="sample"
          style={`font-family: var(--font-${step.font}); font-size: min(${step.sizePx}px, 11vw); line-height: ${step.lineHeight}; font-weight: ${step.weight};`}
        >
          {step.name} — Ndiri nekuti tiri
        </span>
        <span class="spec">
          {step.sizePx}px · {step.sizeRem} · weight {step.weight} · line-height
          {" "}{step.lineHeight} · {step.font} — {step.usage}
        </span>
      </li>
    ))}
  </ul>

  <h2 id="spacing">Spacing</h2>
  <div class="prose"><p>Drawn to scale. The bar is the value.</p></div>
  <ul class="steps">
    {brand.spacing.map((step) => (
      <li class="step">
        <span>
          <span class="name">{step.name}</span>
          <span class="val">{step.px}px · {step.rem}</span>
        </span>
        <span>
          <span class="bar" style={`--w: ${((step.px / maxSpace) * 100).toFixed(2)}%`}></span>
          <span class="val">{step.usage}</span>
        </span>
      </li>
    ))}
  </ul>

  <h2 id="spacing-floor">Spacing floor</h2>
  <div class="prose">
    <p>
      The minimums no component, brand or density setting may go under, even
      one that sets no padding at all. They are numbers the registry
      publishes, and this page prints them as the API serves them.
    </p>
  </div>
  {spacingFloor.length > 0 ? (
    <>
    <ul class="steps">
      {spacingFloor.map((row) => (
        <li class="step">
          <span>
            <span class="name">{row.name}</span>
            <span class="val">{row.value}</span>
          </span>
          <span>
            <span class="val">{row.usage}</span>
          </span>
        </li>
      ))}
    </ul>
    <p class="prose">
      Read from <code>{CANONICAL_BASE}/brand</code> (<code>accessibility</code>)
      when this page was built, <time datetime={builtAt}>{builtAt}</time>. This
      site is held to them: <code>scripts/audit-ui.mjs --guard</code> measures
      the gaps, the insets, the line height and a text-spacing stress pass in a
      browser at 390, 820 and 1440 px.
    </p>
    </>
  ) : (
    <p class="prose">
      <code>{CANONICAL_BASE}/brand</code> as read when this page was built,{" "}
      <time datetime={builtAt}>{builtAt}</time>, does not carry the spacing
      floor yet: the API serves it once its registry pin reaches 4.24.0. No
      number is shown here until it does.
    </p>
  )}

  <h2 id="radii">Radii</h2>
  <div class="prose"><p>{brand.radii.system}</p></div>
  <ul class="radii">
    {radii.map(([name, value]) => (
      <li class="radius">
        <div class="box" style={`--r: ${value}`}></div>
        <strong>{name}</strong> <code>{value}</code>
      </li>
    ))}
  </ul>

  <Separator className="my-12" />

  <h2 id="specs">Component specs, rendered</h2>
  <div class="prose">
    <p>
      The dimensions every component in the registry is built to. They are not
      decorative: on a touch screen a button is a pill at {brand.accessibility.defaultTouchTarget}px
      and never below {brand.accessibility.minTouchTarget}px, because that is the
      touch target this system commits to.{dense && " On a wide screen with a mouse the same pill steps down; the Sizes by screen table below has every number."} Everything on this page — the search
      field on <a href="/components">/components</a>, the badges, the cards, the
      nav pills — is built to these numbers on a touch screen, read from the same API.
    </p>
  </div>
  <ul class="specs">
    {specs.map((spec) => (
      <li class="spec-card">
        <h3>{spec.name}</h3>
        <div class="spec-demo" data-mzizi-spacing-exempt="drawn specimen of a registry component at its spec size, not a container">
          {spec.name === "button" && (
            <>
              <span class="demo-button">Install</span>
              <span class="demo-button outline sm">Docs</span>
            </>
          )}
          {spec.name === "input" && <span class="demo-input">Search components…</span>}
          {spec.name === "avatar" && <span class="demo-avatar">nz</span>}
          {spec.name === "badge" && (
            <>
              <Badge size="sm">ui</Badge>
              <Badge variant="info" size="sm">block</Badge>
              <Badge variant="outline" size="sm">lib</Badge>
            </>
          )}
          {spec.name === "card" && <span class="demo-card">A card is 14px and 1px.</span>}
          {spec.name === "dialog" && <span class="demo-dialog">A dialog is 17px.</span>}
          {spec.name === "toggle" && <span class="demo-toggle"></span>}
          {spec.name === "checkbox" && (
            <>
              <span class="demo-checkbox"></span>
              <span class="demo-checkbox off"></span>
            </>
          )}
          {spec.name === "tabs" && (
            <>
              <span class="demo-tab on">Preview</span>
              <span class="demo-tab">Code</span>
            </>
          )}
        </div>
        <dl>
          <dt>Radius</dt>
          <dd>{spec.borderRadius >= 9999 ? "pill" : `${spec.borderRadius}px`}</dd>
          <dt>Height</dt>
          <dd>
            {Object.entries(spec.heights)
              .filter(([, height]) => height > 0)
              .map(([size, height]) => `${size} ${height}px`)
              .join(", ") || "auto"}
          </dd>
          <dt>Padding</dt>
          <dd>{spec.padding}</dd>
          <dt>Variants</dt>
          <dd>{spec.variants.join(", ")}</dd>
        </dl>
        {spec.note && <p class="note">{spec.note}</p>}
      </li>
    ))}
  </ul>

  {dense && (
    <>
      <h2 id="sizes">Sizes by screen</h2>
      <div class="prose">
        <p>
          Sizes step down as screens grow, by the media query under each column.
          Size is the only thing that changes: it says nothing about the network.
          Read from{" "}
          <a href="https://api.mzizi.dev/v1/ui/mzizi-tokens-globals">/v1/ui/mzizi-tokens-globals</a>{" "}
          at {builtAt}.
        </p>
      </div>
      <div class="sizes-scroll" role="region" aria-label="Sizes by screen, scrolls sideways on a narrow screen" tabindex="0">
      <table class="sizes" id="sizes-table">
        <thead>
          <tr>
            <th scope="col">Role</th>
            {layers.map((l) => (
              <th scope="col">{l.label}{" "}{l.query && <small>{l.query}</small>}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {SIZE_ROLES.map(([token, label]) => (
            <tr>
              <th scope="row">{label} <code>--{token}</code></th>
              {layers.map((l) => (
                <td data-size={token} data-layer={l.id} data-px={l.px[token]}>{l.px[token] === undefined ? "—" : `${l.px[token]}px`}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </>
  )}

  <h2 id="accessibility">What these values are held to</h2>
  <Card className="flow prose my-6">
    <p>
      <strong>{brand.accessibility.standard}.</strong>
      {" "}{brand.accessibility.contrastDescription}
    </p>
    <p>
      Focus: {brand.accessibility.focusIndicator}. Touch targets:
      {" "}{brand.accessibility.defaultTouchTarget}px by default, never below
      {" "}{brand.accessibility.minTouchTarget}px{desktop?.px["size-touch"] !== undefined && desktop.px["target-floor"] !== undefined && `; on desktop ${desktop.px["size-touch"]}px by default, never below ${desktop.px["target-floor"]}px`}.
      {" "}{brand.accessibility.keyboardNavigation}.
      {" "}{brand.accessibility.screenReaders}.
    </p>
  </Card>

  <Separator className="my-12" />

  <h2>Reading this as a machine</h2>
  <div class="prose">
    <p>
      The whole brand system — every family, container step, semantic role, type
      step, spacing step, radius and component spec — is served as JSON at{" "}
      <code>{CANONICAL_BASE}/brand</code>. Token files are generated from it, and
      nothing in this ecosystem should be holding its own copy of a hex value.
      This site does not: it takes every value from <code>@bundu/ui</code>, which is
      generated from this API, and <code>src/styles/site.css</code> types no colour
      at all.
    </p>
  </div>
</Site>
