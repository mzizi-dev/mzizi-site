---
import Site from "../layouts/Site.astro";
import RustCrates from "../components/RustCrates.astro";
import StaticTabs from "../components/StaticTabs";
import Hero from "@bundu/ui/Hero.astro";
import Section from "@bundu/ui/Section.astro";
import SectionHeader from "@bundu/ui/SectionHeader.astro";
import { Alert } from "@bundu/ui/ui/alert";
import { Badge } from "@bundu/ui/ui/badge";
// `buttonVariants` rather than <Button variant=…> in this file: with Hero.astro
// in the same program, astro check loses Button's variant props (a checker
// quirk; <Button> type-checks in a file without Hero). Same classes either way.
import { buttonVariants } from "@bundu/ui/ui/button";
import { Card } from "@bundu/ui/ui/card";
import {
  getComponents,
  getComponentRecords,
  rustCrates,
  rustCrateStates,
  npmStatus,
  builtAt,
  CANONICAL_BASE,
} from "../lib/registry";

/**
 * The front door, and it leads with the language.
 *
 * Mzizi's main goal is the language (`mzizi-dev/mzizi`): a syntax, a type
 * system and a compiler feedback loop designed for machine authorship. This
 * page says what that is, what it has and has not shown, and then how the rest
 * of Mzizi (the toolchain, and the components as Mzizi Roots) supports it.
 * The components are part of Mzizi, not a separate product; they sit further
 * down because they serve the language, not the other way round.
 *
 * Every claim here is checkable against a file in this org:
 * `mzizi-dev/mzizi/CHARTER.md` for what Mzizi is and what it has not yet
 * proven, `benchmarks/results/` there for the two pilots that have run,
 * `benchmarks/READINESS.md` for what the kill-criterion run still waits on,
 * and the repositories themselves for the rest. The status panel is the most
 * important block on the site. It stays second on the page and it stays strict.
 *
 * The contract bench is a live instance of `mz contract`, not a mock-up:
 * `primitives/button.mz` (mirrored verbatim, cited below) and the three
 * clauses it declares, re-implemented in this page's own script so a visitor
 * can edit a height and watch it fail. Every message the script can print was
 * checked against a real `mz contract` run first; see the commit cited in the
 * bench footer. Without JavaScript the bench still renders: the unedited file
 * and its real all-pass result are in the HTML, built below.
 */

const [{ total }, records] = await Promise.all([getComponents(), getComponentRecords()]);
const rustCount = [...records.values()].filter((record) => record.rust !== null).length;
// Asked at build time (and dated in the provenance line below), never typed
// in: a crate's state and the CLI's version change without an edit here.
// The crates are the ones the Rust documents name, per component; never one
// crate typed in for all of them.
const [crates, cli] = await Promise.all([
  rustCrateStates(rustCrates(records)),
  npmStatus("@nyuchi/mzizi-cli"),
]);
const cliVersion = cli.state === "published" ? cli.version : null;

const CHARTER = "https://github.com/mzizi-dev/mzizi/blob/main/CHARTER.md";

// ---------------------------------------------------------------------------
// The bench's first paint, rendered at build time.
//
// The same markup the inline script produces for the unedited file, minus the
// +/- controls (which do nothing without the script). The script replaces it
// on load. A reader with JavaScript off sees the real file and its real
// all-pass summary, which is a true statement, not a placeholder.
// ---------------------------------------------------------------------------
const benchOrder = ["default", "sm", "lg", "icon", "icon_sm"] as const;
const benchHeights: Record<(typeof benchOrder)[number], number> = {
  default: 56,
  sm: 48,
  lg: 56,
  icon: 56,
  icon_sm: 48,
};
const ln = (n: number | string, html: string) =>
  `<div class="ln"><b>${n}</b><span>${html}</span></div>`;
const benchSrc = [
  ln(17, '  <span class="kw">enum</span> <span class="ty">button_size</span>'),
  ...benchOrder.map(
    (k, i) =>
      `<div class="bench-size"><b>${18 + i}</b><span>    ${(k + "          ").slice(0, 10)}<span class="kw">height</span></span><span class="bench-step"><output>${benchHeights[k]}</output></span></div>`,
  ),
  ln(23, '  <span class="kw">end</span>'),
  ln("&#8942;", ""),
  ln(46, '  <span class="kw">contract</span>'),
  ln(
    47,
    '    <span class="kw">every</span> <span class="ty">button_size</span> height <span class="kw">at_least</span> <span class="num">48</span>',
  ),
  ln(
    48,
    '    <span class="ty">button_size</span>.default height <span class="kw">is</span> <span class="num">56</span>',
  ),
  ln(
    49,
    '    <span class="ty">button_size</span>.sm height <span class="kw">is</span> <span class="num">48</span>',
  ),
  ln(
    50,
    '    <span class="ty">button_variant</span>.default class <span class="kw">contains</span> "bg-primary"',
  ),
  ln(51, '    slot <span class="kw">is</span> "button"'),
  ln(52, '  <span class="kw">end</span>'),
].join("");
const benchTerm =
  '<div class="cmd">$ mz contract primitives/button.mz</div>' +
  '<div class="ok">mz: 0 errors (0 exact-fixable), 5 contract clauses, 0 failed, 0ms</div>';

// What the language is, and what it deliberately is not. From CHARTER.md §3
// and §5, and the README's "What doesn't exist yet".
const isList = [
  {
    what: "A language",
    note: "Syntax and a type system that put what an agent reasons about (a variant's touch height, a component's capabilities) in declarations rather than in strings it has to parse back out.",
  },
  {
    what: "A compiler, mz",
    note: "Lexer, recovering parser, name and type resolver, and the agent diagnostic protocol. The compiler crate has no dependencies of its own.",
  },
  {
    what: "An intermediate representation",
    note: "Content-addressed, so a change has an identity an agent can cache, compare and patch against.",
  },
  {
    what: "Contracts",
    note: "A component states what must hold, and mz contract checks it. The bench at the top of this page is the first instance.",
  },
];

const isntList = [
  {
    what: "Not a rendering engine",
    note: "Mzizi is designed to lower to Rust and Dioxus. Rendering is interop, not a rebuilt engine.",
  },
  {
    what: "Not an ML runtime",
    note: "Candle is the dependency when inference arrives (Phase 2).",
  },
  {
    what: "Not a post-quantum cryptography project",
    note: "A stated non-goal, not an omission.",
  },
  {
    what: "Not yet a release",
    note: "No lowering to Rust, no code generation, no runtime, no published compiler crate or binary. mz is built from a checkout.",
  },
];

// Owner direction, 2026-09-29. Direction, not shipped: every line says so.
const direction = [
  {
    what: "The backend, too",
    note: "Mzizi is meant to build its entire backend infrastructure as well as its UI. Backend handlers are the next thing a contract has to describe.",
  },
  {
    what: "Two frontend shapes",
    note: "Astro in front with Mzizi UI (Roots) underneath, or pure Rust end to end.",
  },
  {
    what: "Everything carries a contract",
    note: "Components, language functions and backend handlers. The mz contract bench on this page is the first instance; the rest is design, in RFC-0010, a draft with nothing implemented.",
  },
  {
    what: "A wider benchmark",
    note: "Beyond Dioxus and Leptos, to TypeScript/React, Python, Go and C++, and Rust backends, frontend and backend. RFC-0009 designs it and is a draft; none of those arms has been added, and nothing has been measured against them.",
  },
];

// The toolchain: what makes the language stronger. Each one is a real thing
// in a public repository (or a live host), described at its current state.
const toolchain = [
  {
    name: "mz",
    href: "https://github.com/mzizi-dev/mzizi/tree/main/compiler",
    kind: "Compiler",
    note: "check, fix, contract, outline, hash and ir. Built from a checkout with stable Rust; there is no release yet.",
  },
  {
    name: "mz check --agent",
    href: "/language#trying-it",
    kind: "Agent diagnostics",
    note: "NDJSON, one line per real error, with an exact character span, a plain-language message and a fix tagged exact or guess.",
  },
  {
    name: "benchmarks/",
    href: "https://github.com/mzizi-dev/mzizi/tree/main/benchmarks",
    kind: "Benchmark harness",
    note: "The Phase 0 harness, the runner, the Dioxus and Leptos arms, an open-weight arm and the kill-criterion driver. It scored both pilots. The held-out task set is not written yet, and will be private by design.",
  },
  {
    name: "mcp.mzizi.dev",
    href: "https://mcp.mzizi.dev/mcp",
    kind: "MCP server",
    note: "The registry, skills and docs as tools an agent can call. Free, no sign-in, except the Fundi tools.",
  },
  {
    name: "The CLIs",
    href: "/cli",
    kind: "Command line",
    note: `mz for the language; mzizi add (in @nyuchi/mzizi-cli${cliVersion ? ` ${cliVersion}` : ""}), cargo add or npx shadcn for components; fundi, the agent. Free, with no gate.`,
  },
];

// Checked live (DNS + a request), not assumed. The whole point of this table
// is that an address the ecosystem writes down is not the same as one that
// exists. Re-checked 2026-09-29.
const surfaces = [
  {
    what: "The language",
    host: "github.com/mzizi-dev/mzizi",
    repo: "mzizi",
    note: "Compiler, primitives, RFCs, benchmark harness and results. Public.",
  },
  {
    what: "This site",
    host: "mzizi.dev",
    repo: "mzizi-site",
    note: "Static Astro, cut over from the registry's own Worker.",
  },
  {
    what: "Registry API",
    host: "api.mzizi.dev",
    repo: "mzizi-api-gateway",
    note: `${total} components, brand, tokens, the DNA-helix architecture. A Hono Worker serving the registry's files, bundled at a pinned commit; no database.`,
  },
  {
    what: "MCP server",
    host: "mcp.mzizi.dev",
    repo: null,
    note: "Serves the registry, Rust first, and the skills from bundled files, and joins in the docs from docs.mzizi.dev/mcp.",
  },
  {
    what: "Documentation",
    host: "docs.mzizi.dev",
    repo: "mzizi-docs",
    note: "Mintlify, the one home of Mzizi's documentation.",
  },
  {
    what: "Console",
    host: "app.mzizi.dev",
    repo: "mzizi-console",
    note: "Run by Nyuchi. Astro chrome, Rust/Dioxus islands, WorkOS sign-in.",
  },
];

const notYet = [
  {
    what: "The Phase 0 measurement",
    note: "Two pilots have run (see the status above). The run that tests the kill criterion has not. Most of the fixes pilot 2 named have landed; it still needs the runner's spec and React arm, held-out tasks, a pre-registered PLAN.md, the Leptos arm run end to end, and a Mzizi backend arm (benchmarks/READINESS.md).",
  },
  {
    what: "Lowering, code generation, a runtime, a release",
    note: "The language has a front end and contract evaluation. Nothing it compiles runs yet.",
  },
  {
    what: "The wider benchmark and the backend",
    note: "TypeScript/React, Python, Go, C++ and Rust-backend arms (RFC-0009), and contracts for functions and backend handlers (RFC-0010), are direction. Both RFCs are drafts; nothing in them is implemented.",
  },
];

type Repo = {
  name: string;
  lang: string;
  langColor: string;
  desc: string;
  lead?: boolean;
  tag?: string;
};

const repos: Repo[] = [
  {
    name: "mzizi",
    lang: "Rust",
    langColor: "var(--color-copper)",
    desc: "The language: compiler, primitives, RFCs, roadmap, benchmark harness and results.",
    lead: true,
  },
  {
    name: "mzizi-registry",
    lang: "TypeScript + Rust",
    langColor: "var(--color-cobalt)",
    desc: `${total} components, the brand system, and the benchmark corpus the language is scored against. Mzizi Roots, the Rust components, are written here.`,
  },
  {
    name: "mzizi-api-gateway",
    lang: "TypeScript",
    langColor: "var(--color-cobalt)",
    desc: "api.mzizi.dev: a Hono Cloudflare Worker serving the registry API from the registry's files, bundled at build time. No database.",
  },
  {
    name: "mzizi-site",
    lang: "Astro",
    langColor: "var(--color-malachite, var(--info))",
    desc: "This site: the language first, then the toolchain and components that support it.",
  },
  {
    name: "mzizi-docs",
    lang: "MDX",
    langColor: "var(--color-sodalite, var(--muted-foreground))",
    desc: "The Mintlify documentation site, live at docs.mzizi.dev: the one home of Mzizi's docs.",
  },
  {
    name: "mzizi-console",
    lang: "Rust",
    langColor: "var(--color-copper)",
    desc: "app.mzizi.dev, run by Nyuchi: Astro chrome over Rust/Dioxus islands, reading the registry API live.",
  },
];
---

<Site
  title="Mzizi"
  description="Mzizi is a language for the agentic web, in Rust: a syntax, type system and compiler feedback loop designed for machine authorship. Phase 0: two pilots have run, and neither showed an advantage yet."
  bare
>
  <Hero
    layout="split"
    variant="showcase"
    badge="Phase 0 · research prototype"
    subtitle="The Mzizi language"
    title="A language designed for machines to write."
    description="Mzizi is a research language and compiler for machine authorship by small open-weight models. Every component states a contract, and the compiler checks it."
    primaryCTA={{ text: "Try the contract bench", href: "#bench" }}
    secondaryCTA={{ text: "Read the charter", href: CHARTER, external: true }}
    mediaLabel="The contract bench: primitives/button.mz and mz contract"
  >
    <div slot="media" id="bench" class="bench" aria-labelledby="bench-title">
      <div class="bench-head">
        <h2 id="bench-title">primitives/button.mz</h2>
        <p>Change a touch height. The contract answers.</p>
      </div>
      <div class="bench-src" id="bench-src" set:html={benchSrc} />
      <div class="bench-term" id="bench-term" aria-live="polite" set:html={benchTerm} />
      <div class="bench-foot">
        Messages are verbatim from <code>mz contract</code>, checked against a real
        run at <a href="https://github.com/mzizi-dev/mzizi/blob/e9e9233/primitives/button.mz">e9e9233</a>.
        The check is re-implemented in this page's script so you can play with it.
        Each step changes a size's class and its height together (<code>h-12</code>{" "}
        and 48 to <code>h-11</code> and 44): change the height alone and{" "}
        <code>mz check</code> stops first, with MZ0313, because the class still
        renders the old height.{" "}
        <code>0ms</code> is wall-clock time for the contract check alone, rounded
        down to whole milliseconds; reading the file and starting the process are
        not included.
        <button class="bench-reset" id="bench-reset" type="button">Reset</button>
      </div>
    </div>
  </Hero>

  <Section bg="secondary" border id="status">
    <Alert
      variant="warning"
      role="region"
      aria-labelledby="status-title"
      className="status flow text-body p-6 md:p-8"
    >
      <h2 id="status-title">Status: two pilots, no advantage yet</h2>
      <p>
        The compiler front end exists and is tested: a lexer, a recovering parser,
        an agent diagnostic protocol with <code>mz fix</code> to apply its exact
        fixes, a content-addressed IR, and nine primitives written in Mzizi
        itself. Contract blocks are evaluated (see the bench above), and the
        benchmark harness scores an agent's output against the registry's
        reference implementation.
      </p>
      <p>
        <strong
          >Two pilot runs on 2026-09-27 show no measurable advantage for Mzizi.</strong
        > With a frontier model, the Mzizi and Dioxus arms were indistinguishable on
        clean compiles and defects, and Mzizi used about 8% fewer tokens. With a ~7B
        open-weight model, the size the design targets, Mzizi did worse on all
        three metrics (2 of 6 clean compiles against Dioxus's 4 of 6). Both pilots
        are tiny (two scored tasks, three seeds), and neither is the Phase 0 number.{" "}
        <a href="https://github.com/mzizi-dev/mzizi/blob/main/benchmarks/results/2026-09-27-pilot-2/RUN.md"
          >The write-up</a
        > names the three failure mechanisms and what has to change before a run
        that tests the kill criterion.
      </p>
      <p>
        <strong>Phase 0 is not complete, and the kill-criterion run has not
          happened.</strong> Most of the fixes pilot 2 asked for have landed since:{" "}
        <code>mz fix</code>; diagnostics for the React idioms Mzizi has no form for
        (MZ0106, MZ0312); a declared <code>height</code> that disagrees with its
        class is now a compile error (MZ0313); relative paths in the diagnostics
        an agent reads; a <code>slot_set</code> fact and a <code>card</code> task;
        and a kill-criterion driver that will not start without a pre-registered{" "}
        <code>PLAN.md</code>.{" "}
        <a href="https://github.com/mzizi-dev/mzizi/blob/main/benchmarks/READINESS.md"
          ><code>benchmarks/READINESS.md</code></a
        > audits each one. The run still waits on five things: the runner's
        language-neutral <code>spec.md</code> input, <code>arm.toml</code>, a React
        arm and guides balanced to within 5%; held-out tasks, in a private
        repository that does not exist yet; the <code>PLAN.md</code> itself; the
        Leptos arm run end to end; and a Mzizi backend arm, which needs language
        work first.
      </p>
      <p>
        <strong>The kill criterion is Mzizi against the best existing language for
          each kind of task</strong>
        (<a href="https://github.com/mzizi-dev/mzizi/blob/main/design/RFC-0009-comparison-benchmark.md"
          >RFC-0009</a
        > §6). The aim is to rank with the top languages, not only to beat Dioxus
        or Leptos. Within a task family, the bar on each of the three metrics is
        the best value any existing language reached, and Mzizi must beat it on
        two of the three, on held-out tasks, with the ~7B model. A win counts only
        when a paired bootstrap's 95% interval for the difference excludes zero.
        Phase 0 passes only if both gating families, UI (<code>ui-spec</code>) and{" "}
        <code>backend</code>, pass. None of that has been measured. If it shows no
        measurable advantage, nothing downstream matters. Treat every claim on
        this site as a design intent with an argument behind it, not a result.
      </p>
      <p>
        Every run is published, whichever way it falls. Each one lands in{" "}
        <a href="https://github.com/mzizi-dev/mzizi/tree/main/benchmarks/results"
          ><code>benchmarks/results/</code></a
        > in <code>mzizi-dev/mzizi</code>, raw episodes included. A held-out run
        publishes its scores on the day; its task texts are published when that
        task set is retired.
      </p>
    </Alert>

    <ul class="figs">
      <li class="fig"><b>308</b><span>tests passing, 14 suites</span></li>
      <li class="fig"><b>29</b><span>contract clauses in the nine primitives, all passing</span></li>
      <li class="fig"><b>7,454</b><span>lines of Rust in the compiler</span></li>
      <li class="fig"><b>2</b><span>pilots run, 0 showing an advantage</span></li>
    </ul>
    <p class="provenance">
      <span>
        Compiler figures from a fresh build of <code>mzizi-dev/mzizi</code> at{" "}
        <a href="https://github.com/mzizi-dev/mzizi/commit/e9e9233"><code>e9e9233</code></a>{" "}
        (<code>cargo test --workspace</code>; lines in <code>compiler/src</code>;{" "}
        <code>mz contract</code> over <code>primitives/*.mz</code>). Pilots from{" "}
        <a href="https://github.com/mzizi-dev/mzizi/tree/main/benchmarks/results"
          ><code>benchmarks/results/</code></a
        >, both dated 2026-09-27.
      </span>
    </p>
  </Section>

  <Section id="why">
    <SectionHeader
      eyebrow="Why"
      title="Built for the agent in the loop"
      description="A narrow claim on purpose: a design intent with an argument behind it, not a result yet."
    />
    <div class="grid-2">
      <Card className="flow">
        <h3>A different bottleneck</h3>
        <p>
          Every web framework in use today was designed on the assumption that a
          human is typing: reading docs, holding context in their head, tolerating
          a few seconds per compile. Mzizi starts from an agent iterating against a
          compiler thousands of times, where compile speed, the information density
          of an error message, and how many tokens a codebase costs to read are
          first-order metrics rather than nice-to-haves.
        </p>
      </Card>
      <Card className="flow">
        <h3>The machines that need the help most</h3>
        <p>
          It designs for small open-weight models with limited parameters, context
          and long-range attention. That is the whole of the claim, and it is a
          narrow one on purpose. It is a design intent with an argument behind it.
          It is not a result yet.
        </p>
      </Card>
    </div>
  </Section>

  <Section id="contracts" bg="secondary" border>
    <SectionHeader
      eyebrow="Contracts"
      title="Everything carries a contract"
      description="A Mzizi component says what must hold about it, in the same file, in a form the compiler checks."
    />
    <div class="grid-3">
      <Card className="flow">
        <Badge variant="outline" className="mb-3">Today</Badge>
        <h3>What the bench checks</h3>
        <p>
          <code>primitives/button.mz</code> declares that every button size is at
          least 48px tall, that the default is 56 and the small size 48. Break one
          and <code>mz contract</code> names the line, the clause and the value.
        </p>
      </Card>
      <Card className="flow">
        <Badge variant="outline" className="mb-3">The rule</Badge>
        <h3>All of Mzizi</h3>
        <p>
          The owner has set it for all of Mzizi: everything built carries a
          contract. Components today; language functions and backend handlers are
          next, and are design, not code.
        </p>
      </Card>
      <Card className="flow">
        <Badge variant="outline" className="mb-3">Not yet</Badge>
        <h3>What it does not do</h3>
        <p>
          Contract evaluation checks a component's declarations against its own
          contract. It checks nothing rendered. The comparison against a reference
          implementation is the benchmark harness's job.
        </p>
      </Card>
    </div>
    <p class="section-links">
      <a href="#bench">Try it in the bench ↑</a>
    </p>
  </Section>

  <Section id="what-it-is">
    <SectionHeader
      eyebrow="The language"
      title="What the language is, and what it isn't"
      description="From the charter (§3 and §5) and the language README's “What doesn't exist yet”."
    />
    <StaticTabs
      id="language-tabs"
      label="What the language is, isn't, and where it is going"
      tabs={[
        { value: "is", label: "It is" },
        { value: "isnt", label: "It isn't" },
        { value: "direction", label: "Direction, not shipped" },
      ]}
    >
      <ul slot="is" class="card-list">
        {
          isList.map((n) => (
            <li>
              <Card padding="sm" className="h-full">
                <strong>{n.what}</strong>
                <p>{n.note}</p>
              </Card>
            </li>
          ))
        }
      </ul>
      <ul slot="isnt" class="card-list">
        {
          isntList.map((n) => (
            <li>
              <Card padding="sm" className="h-full">
                <strong>{n.what}</strong>
                <p>{n.note}</p>
              </Card>
            </li>
          ))
        }
      </ul>
      <ul slot="direction" class="card-list">
        {
          direction.map((d) => (
            <li>
              <Card padding="sm" className="h-full">
                <strong>{d.what}</strong>
                <p>{d.note}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </StaticTabs>
    <p class="section-links">
      <a href="/language">The design goals, the phasing and the RFCs →</a>
    </p>
  </Section>

  <Section id="toolchain" bg="secondary" border>
    <SectionHeader
      eyebrow="Toolchain"
      title="The toolchain"
      description="The compiler is the language. Everything else here makes it stronger: it gives an agent a denser loop, it measures whether the language works, and it puts the corpus within an agent's reach."
    />
    <ul class="card-list">
      {
        toolchain.map((t) => (
          <li>
            <Card padding="sm" className="h-full">
              <Badge variant="outline" size="sm" className="mb-2">{t.kind}</Badge>
              <a class="card-title" href={t.href}>
                {t.name}
              </a>
              <p>{t.note}</p>
            </Card>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="components">
    <SectionHeader
      eyebrow="Components"
      title="The components: Mzizi Roots"
      description="Part of Mzizi, not a separate product: the benchmark corpus the language is scored against, and where its output is meant to land."
    />
    <div class="grid-2">
