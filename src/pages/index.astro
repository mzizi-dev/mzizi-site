---
import Site from "../layouts/Site.astro";
import RustCrates from "../components/RustCrates.astro";
import Progress from "../components/Progress.astro";
import ProgramRun from "../components/ProgramRun.astro";
import { errorsProgram } from "../lib/programs";
import StaticTabs from "../components/StaticTabs";
import Hero from "@bundu/ui/Hero.astro";
import Section from "@bundu/ui/Section.astro";
import SectionHeader from "@bundu/ui/SectionHeader.astro";
import { Alert } from "@bundu/ui/ui/alert";
import { Badge } from "@bundu/ui/ui/badge";
// `buttonVariants` rather than <Button variant=…> in this file: with Hero.astro
// in the same program, astro check loses Button's variant props (a checker
// quirk; <Button> type-checks in a file without Hero). Same classes either way.
import { buttonVariants } from "@bundu/ui/ui/button";
import { Card } from "@bundu/ui/ui/card";
import {
  getComponents,
  getComponentRecords,
  rustCrates,
  rustCrateStates,
  npmStatus,
  builtAt,
  CANONICAL_BASE,
} from "../lib/registry";

/**
 * The front door, and it leads with the language.
 *
 * Mzizi is a programming language (`mzizi-dev/mzizi`). Its goal (owner,
 * 2026-09-30) is to be the language people choose instead of TypeScript,
 * Python and C++, and its edge is machine authorship: syntax, types,
 * contracts and diagnostics designed for an agent in the compile loop. This
 * page says what that is, what it has and has not shown, what Phase 0
 * measures it against, and then how the rest of Mzizi supports it: the
 * toolchain (the `mz` compiler, the CLI, the MCP server, the skills and the
 * Phase 0 benchmark harness) and the components (Mzizi Roots and the
 * registry). Neither of those is the language. The harness at the language's
 * core (owner, 2026-09-30) is part of the language, designed in RFC-0012 and
 * not built. They sit further down because they serve the language, not the
 * other way round.
 *
 * What the language can and cannot do is taken from the language repo's
 * LANGUAGE-TRACKER.md, the one tracker of what Mzizi still needs (owner,
 * 2026-09-30). If a capability is not ✅ there, this page does not claim it.
 *
 * The goal is stated as a goal. Nothing on this page may say Mzizi already
 * beats TypeScript, Python or C++: the comparison section is the benchmark's
 * question (RFC-0009 §1–§2), not a results table.
 *
 * Every claim here is checkable against a file in this org:
 * `mzizi-dev/mzizi/CHARTER.md` for what Mzizi is and what it has not yet
 * proven, RFC-0009 there for the arms, families and kill criterion,
 * `benchmarks/results/` for the two pilots that have run,
 * `benchmarks/READINESS.md` for what the kill-criterion run still waits on,
 * and the repositories themselves for the rest. The status panel is the most
 * important block on the site. It stays second on the page and it stays strict.
 *
 * The contract bench is a live instance of `mz contract`, not a mock-up:
 * `primitives/button.mz` (mirrored verbatim, cited below) and the three
 * clauses it declares, re-implemented in this page's own script so a visitor
 * can edit a height and watch it fail. Every message the script can print was
 * checked against a real `mz contract` run first; see the commit cited in the
 * bench footer. Without JavaScript the bench still renders: the unedited file
 * and its real all-pass result are in the HTML, built below.
 */

const [{ total }, records] = await Promise.all([getComponents(), getComponentRecords()]);
const rustCount = [...records.values()].filter((record) => record.rust !== null).length;
// Asked at build time (and dated in the provenance line below), never typed
// in: a crate's state and the CLI's version change without an edit here.
// The crates are the ones the Rust documents name, per component; never one
// crate typed in for all of them.
const [crates, cli] = await Promise.all([
  rustCrateStates(rustCrates(records)),
  npmStatus("@nyuchi/mzizi-cli"),
]);
const cliVersion = cli.state === "published" ? cli.version : null;

const CHARTER = "https://github.com/mzizi-dev/mzizi/blob/main/CHARTER.md";
const TRACKER = "https://github.com/mzizi-dev/mzizi/blob/main/LANGUAGE-TRACKER.md";
// The language commit the figures below were read at: a fresh build, not the
// README. scripts/check-facts.py notes when main has moved past it.
const LANG_COMMIT = "4d0cdc3";

// ---------------------------------------------------------------------------
// The bench's first paint, rendered at build time.
//
// The same markup the inline script produces for the unedited file, minus the
// +/- controls (which do nothing without the script). The script replaces it
// on load. A reader with JavaScript off sees the real file and its real
// all-pass summary, which is a true statement, not a placeholder.
// ---------------------------------------------------------------------------
const benchOrder = ["default", "sm", "lg", "icon", "icon_sm"] as const;
const benchHeights: Record<(typeof benchOrder)[number], number> = {
  default: 56,
  sm: 48,
  lg: 56,
  icon: 56,
  icon_sm: 48,
};
const ln = (n: number | string, html: string) =>
  `<div class="ln"><b>${n}</b><span>${html}</span></div>`;
const benchSrc = [
  ln(17, '  <span class="kw">enum</span> <span class="ty">button_size</span>'),
  ...benchOrder.map(
    (k, i) =>
      `<div class="bench-size"><b>${18 + i}</b><span>    ${(k + "          ").slice(0, 10)}<span class="kw">height</span></span><span class="bench-step"><output>${benchHeights[k]}</output></span></div>`,
  ),
  ln(23, '  <span class="kw">end</span>'),
  ln("&#8942;", ""),
  ln(46, '  <span class="kw">contract</span>'),
  ln(
    47,
    '    <span class="kw">every</span> <span class="ty">button_size</span> height <span class="kw">at_least</span> <span class="num">48</span>',
  ),
  ln(
    48,
    '    <span class="ty">button_size</span>.default height <span class="kw">is</span> <span class="num">56</span>',
  ),
  ln(
    49,
    '    <span class="ty">button_size</span>.sm height <span class="kw">is</span> <span class="num">48</span>',
  ),
  ln(
    50,
    '    <span class="ty">button_variant</span>.default class <span class="kw">contains</span> "bg-primary"',
  ),
  ln(51, '    slot <span class="kw">is</span> "button"'),
  ln(52, '  <span class="kw">end</span>'),
].join("");
const benchTerm =
  '<div class="cmd">$ mz contract primitives/button.mz</div>' +
  '<div class="ok">mz: 0 errors (0 exact-fixable), 5 contract clauses, 0 failed, 0ms</div>';

// What the language is, and what it deliberately is not. From CHARTER.md §1,
// §3 and §5, and the README's "What doesn't exist yet". The language is its
// syntax, type system, semantics and contracts. The compiler, the IR and the
// diagnostics are the toolchain that implements it (owner, 2026-09-30), so
// they are listed under "It isn't" and described in the toolchain section.
const isList = [
  {
    what: "A programming language",
    note: "Designed to be general-purpose. Today it can declare UI components, one kind of backend program (a service with HTTP routes and handlers, RFC-0011), and programs that compute (RFC-0013). In a program, Mzizi has expressions, bindings, functions, control flow, error handling, collections and records with methods, over int, float, bool, text and enums; the tracker marks those rows ✅ (C1–C5, C7–C10). On main it has no modules, standard library or concurrency yet, and text operations are only partly built (C6 🟡; LANGUAGE-TRACKER.md). Rust is its platform, the way JavaScript is TypeScript's: it is designed to lower to Rust, and today a service lowers to a local Rust + axum package and a program to a Rust package with no dependencies. Its goal is to be the language you choose instead of TypeScript, Python or C++.",
  },
  {
    what: "Syntax and a type system",
    note: "They put what an agent reasons about (a variant's touch height, a component's capabilities) in declarations rather than in strings it has to parse back out, with one construct per intent.",
  },
  {
    what: "Semantics an agent can check",
    note: "A declared fact that disagrees with what the code renders is a compile error, not a runtime surprise: a height that disagrees with its class is MZ0313.",
  },
  {
    what: "Contracts, as a language feature",
    note: "A component states what must hold about it in the same file, in the language itself. The toolchain's mz contract checks it; the bench at the top of this page is the first instance.",
  },
  {
    what: "A harness at its core, by design",
    note: "The harness is the core of Mzizi: the layer an agent reads and works through. It covers the language as an agent sees it (grammar, types, contracts, canonical form), the agent protocol (mz check --agent, its diagnostics and fixes, RFC-0001 §4), and the plugin host the toolchain, the CLI, the MCP server and plugins attach to natively. Part of it exists today: mz check --agent's output, and the language harness's first slice, an entry for every feature a program has, which mz harness prints. The harness as a whole is designed, not built: RFC-0012, a draft, is its design, and its plugin host is not built. It lives in the language repository, mzizi-dev/mzizi, and the agent-tools packages (the CLI, the MCP server, fundi) are its clients.",
  },
];

const isntList = [
  {
    what: "Not its toolchain",
    note: "The mz compiler, its content-addressed IR, mz fix and mz contract implement and support the language, and are meant to attach to its harness. They are not the language. See the toolchain below.",
  },
  {
    what: "Not its components",
    note: "Mzizi Roots and the registry are built to support the language, as its UI layer and where its output is meant to land. See the components below.",
  },
  {
    what: "Not a rendering engine",
    note: "Mzizi is designed to lower to Rust and Dioxus. Rendering is interop, not a rebuilt engine.",
  },
  {
    what: "Not an ML runtime",
    note: "Candle is the dependency when inference arrives (Phase 2).",
  },
  {
    what: "Not a post-quantum cryptography project",
    note: "A stated non-goal, not an omission.",
  },
  {
    what: "Not yet a release",
    note: "A service lowers, to a local Rust + axum package (mz build), and a program to a Rust package with no dependencies, which mz run builds and runs. No component lowers yet, and there is no Workers, Containers or WebAssembly target and no published compiler crate or binary. A release is a git tag, not a package: mz is built from a checkout.",
  },
];

// Owner direction, 2026-09-29. Direction, not shipped: every line says so.
const direction = [
  {
    what: "The backend, too",
    note: "Mzizi is meant to build its entire backend infrastructure as well as its UI. The first slice exists: a service with HTTP routes and handlers, which mz check checks, mz contract runs in process and mz build lowers to a local Rust + axum package (RFC-0011). No Mzizi backend is ported, and none will be until the backend family passes the kill criterion.",
  },
  {
    what: "Two frontend shapes",
    note: "Astro in front with Mzizi UI (Roots) underneath, or pure Rust end to end.",
  },
  {
    what: "Everything carries a contract",
    note: "Components, services, language functions and records. Components and services carry contracts today: the mz contract bench on this page is a component's, and a service's run in process, with each ensure tested over generated requests, not proven. Contracts for functions and records are design, in RFC-0010, a draft.",
  },
  {
    what: "A wider benchmark",
    note: "UI against TypeScript with React as well as Dioxus and Leptos; backend against TypeScript, Python, Go, C++ and Rust. RFC-0009 designs it and is a draft. The React arm and the Mzizi backend arm are added and have never run; the other-language backend arms are not added yet, and nothing has been measured against any of them.",
  },
];

// What Mzizi is measured against: the benchmark's question, not its answers.
// Every family and pin is RFC-0009 §1 and §2; every state is benchmarks/arms/
// at mzizi-dev/mzizi 9a88e1d. "exists" means a directory under
// benchmarks/arms/, "not added yet" means RFC-0009 proposes it and there is no
// directory. Nothing here has a result; the results are benchmarks/results/.
type Arm = { lang: string; state: "exists" | "exists, never run" | "not added yet" };
const families: {
  id: string;
  title: string;
  role: string;
  gating: boolean;
  input: string;
  arms: Arm[];
  mzizi: string;
}[] = [
  {
    id: "ui-spec",
    title: "UI components",
    role: "Gating, on held-out tasks",
    gating: true,
    input: "A component written from a language-neutral spec.md: prose and a table of its variants, classes, defaults and slot. No arm is handed code in its own language.",
    arms: [
      { lang: "Rust · Dioxus 0.7.10", state: "exists" },
      { lang: "Rust · Leptos 0.8.21", state: "exists, never run" },
      { lang: "TypeScript · React", state: "exists, never run" },
    ],
    mzizi: "The Mzizi arm exists. The React arm's pins are taken from the registry's lockfile.",
  },
  {
    id: "backend",
    title: "Backend handlers and services",
    role: "Gating, on held-out tasks",
    gating: true,
    input: "HTTP routing, validation, a small stateful service and error paths, from a spec.md, scored by HTTP probes that do not care what language answered.",
    arms: [
      { lang: "TypeScript · Hono", state: "not added yet" },
      { lang: "Python · FastAPI", state: "not added yet" },
      { lang: "Go · net/http", state: "not added yet" },
      { lang: "C++20 · cpp-httplib", state: "not added yet" },
      { lang: "Rust · axum", state: "not added yet" },
    ],
    mzizi: "The Mzizi arm, mzizi-be, exists, with the probe crate (mzprobe) and the first backend task, B1. It has never run: the runner does not score an episode with probes yet, and tasks B2–B5 are not written.",
  },
  {
    id: "ui-port",
    title: "Porting a React component",
    role: "Development only, never gating",
    gating: false,
    input: "A registry component handed over as its spec.tsx, as both pilots were. Kept so a new run can be compared with the pilots.",
    arms: [
      { lang: "Rust · Dioxus", state: "exists" },
      { lang: "Rust · Leptos", state: "exists, never run" },
    ],
    mzizi: "Both pilots ran here, against Dioxus only.",
  },
  {
    id: "public",
    title: "Public suites",
    role: "Comparability, never gating",
    gating: false,
    input: "MultiPL-E, EvalPlus, Aider polyglot and BaxBench, in their own languages (TypeScript, Python, Go, C++ and Rust among them). Their tasks are in every model's training data, so they never decide anything.",
    arms: [],
    mzizi: "Blocked. A program with functions runs since the 8 October release, and it has lists, maps, sets and records with methods on main since the third release (C7, C8). These suites still need text operations that return an option or a list, and a standard library in a program, which Mzizi does not have on main yet (RFC-0009 §8; LANGUAGE-TRACKER.md, Tier 1).",
  },
];

// The toolchain: built to support the language, not the language itself.
// Each one is a real thing in a public repository (or a live host),
// described at its current state.
const toolchain = [
  {
    name: "mz",
    href: "https://github.com/mzizi-dev/mzizi/tree/main/compiler",
    kind: "Compiler",
    note: "The compiler that implements the language: check, fix, contract, outline, build, run and harness, with hash and ir for reading its content-addressed IR. mz build lowers a service to a local Rust + axum package, or a program to a Rust package with no dependencies; mz run builds a program and runs it. mz harness prints the language harness's definition. Built from a checkout with stable Rust; there is no published binary.",
  },
  {
    name: "mz check --agent",
    href: "/language#trying-it",
    kind: "Agent diagnostics",
    note: "NDJSON, one line per real error, with an exact character span, a plain-language message and a fix tagged exact or guess.",
  },
  {
    name: "benchmarks/",
    href: "https://github.com/mzizi-dev/mzizi/tree/main/benchmarks",
    kind: "Phase 0 benchmark",
    note: "The Phase 0 benchmark harness (not the harness at the language's core), the runner, the mzizi, dioxus, leptos, react and mzizi-be arms, the backend probe crate (mzprobe) with task B1, an open-weight setup and the kill-criterion driver. It scored both pilots. The held-out task set is not written yet, and will be private by design.",
  },
  {
    name: "mcp.mzizi.dev",
    href: "https://mcp.mzizi.dev/mcp",
    kind: "MCP server",
    note: "The registry, skills and docs as tools an agent can call. Free, no sign-in, except the Fundi tools.",
  },
  {
    name: "Agent skills",
    href: "/skills",
    kind: "Skills",
    note: "@nyuchi/mzizi-skills: written workflows that teach an agent the language, its toolchain and its components. On npm, and served by the MCP server and the API.",
  },
  {
    name: "The CLIs",
    href: "/cli",
    kind: "Command line",
    note: `mz for the language; mzizi add (in @nyuchi/mzizi-cli${cliVersion ? ` ${cliVersion}` : ""}), cargo add or npx shadcn for components; fundi, the agent. Free, with no gate.`,
  },
];

// Checked live (DNS + a request), not assumed. The whole point of this table
// is that an address the ecosystem writes down is not the same as one that
// exists. Re-checked 2026-09-29.
const surfaces = [
  {
    what: "The language",
    host: "github.com/mzizi-dev/mzizi",
    repo: "mzizi",
    note: "The language's charter and RFCs, the mz compiler that implements it, primitives written in it, and the benchmark harness and results. Public.",
  },
  {
    what: "This site",
    host: "mzizi.dev",
    repo: "mzizi-site",
    note: "Static Astro, cut over from the registry's own Worker.",
  },
  {
    what: "Registry API",
    host: "api.mzizi.dev",
    repo: "mzizi-api-gateway",
    note: `${total} components, brand, tokens, the DNA-helix architecture. A Hono Worker serving the registry's files, bundled at a pinned commit; no database.`,
  },
  {
    what: "MCP server",
    host: "mcp.mzizi.dev",
    repo: null,
    note: "Serves the registry, Rust first, and the skills from bundled files, and joins in the docs from docs.mzizi.dev/mcp.",
  },
  {
    what: "Documentation",
    host: "docs.mzizi.dev",
    repo: "mzizi-docs",
    note: "Mintlify, the one home of Mzizi's documentation.",
  },
  {
    what: "Console",
    host: "app.mzizi.dev",
    repo: "mzizi-console",
    note: "Run by Nyuchi. Astro chrome, Rust/Dioxus islands, WorkOS sign-in.",
  },
];

const notYet = [
  {
    what: "The Phase 0 measurement",
    note: "Two pilots have run (see the status above). The run that tests the kill criterion has not. Most of the fixes pilot 2 named have landed, and the React arm's pins now come from the registry's lockfile; it still needs held-out tasks, a pre-registered PLAN.md, the Leptos and React arms run end to end, and for the backend family, probe scoring in the runner, tasks B2–B5 and the other-language arms (benchmarks/READINESS.md).",
  },
  {
    what: "Most of a programming language, and a release",
    note: "In a program, Mzizi has expressions, bindings, functions, control flow, error handling, collections and records with methods, since the third 8 October release (#104, tagged v0.7.0); on main it has no modules, standard library or concurrency yet, and text operations are only partly built (C6). A service lowers, to a local Rust + axum package, and a program to a Rust package with no dependencies; no component lowers, and there is no Workers, Containers or WebAssembly target. LANGUAGE-TRACKER.md lists what still has to be built, against Python, Go, C++, TypeScript and Rust. M1 needs the rest of text operations next, which waits on the standard library (see the status panel).",
  },
  {
    what: "The wider benchmark",
    note: "The Hono, FastAPI, Go, C++ and axum backend arms (RFC-0009) are not added yet, and the React and mzizi-be arms have never run. Contracts for functions and records (RFC-0010) are design. Both RFCs are drafts.",
  },
];

type Repo = {
  name: string;
  lang: string;
  langColor: string;
  desc: string;
  lead?: boolean;
  tag?: string;
};

const repos: Repo[] = [
  {
    name: "mzizi",
    lang: "Rust",
    langColor: "var(--color-copper)",
    desc: "The language: its charter and RFCs, the mz compiler that implements it, primitives written in it, and the benchmark harness and results.",
    lead: true,
  },
  {
    name: "mzizi-registry",
    lang: "TypeScript + Rust",
    langColor: "var(--color-cobalt)",
    desc: `${total} components built to support the language: its UI layer, with Mzizi Roots (the Rust components) written here, and the brand system. The benchmark's public UI tasks come from here too.`,
  },
  {
    name: "mzizi-api-gateway",
    lang: "TypeScript",
    langColor: "var(--color-cobalt)",
    desc: "api.mzizi.dev: a Hono Cloudflare Worker serving the registry API from the registry's files, bundled at build time. No database.",
  },
  {
    name: "mzizi-site",
    lang: "Astro",
    langColor: "var(--color-malachite, var(--info))",
    desc: "This site: the language first, then the toolchain and components that support it.",
  },
  {
    name: "mzizi-docs",
    lang: "MDX",
    langColor: "var(--color-sodalite, var(--muted-foreground))",
    desc: "The Mintlify documentation site, live at docs.mzizi.dev: the one home of Mzizi's docs.",
  },
  {
    name: "mzizi-console",
    lang: "Rust",
    langColor: "var(--color-copper)",
    desc: "app.mzizi.dev, run by Nyuchi: Astro chrome over Rust/Dioxus islands, reading the registry API live.",
  },
];
---

<Site
  title="Mzizi"
  description="Mzizi is a general-purpose programming language, built to make Rust better, the way TypeScript makes JavaScript better. It has no borrows, lifetimes or ownership in the language you write, and a harness at its core, the layer an agent reads; the aim is that you write Mzizi instead of TypeScript, Python or C++. Phase 0: two pilots have run, and neither showed an advantage yet."
  bare
>
  <Hero
    layout="split"
    variant="showcase"
    badge="Phase 0 · research prototype"
    subtitle="The Mzizi programming language"
    title="Mzizi: a general-purpose programming language."
    description="Built to make Rust better, the way TypeScript makes JavaScript better. How: no borrows, lifetimes or ownership in the language you write, with the harness at the core, the layer an agent reads. That is the goal Phase 0 measures, against the best existing language for each kind of task, not a result."
    primaryCTA={{ text: "Try the contract bench", href: "#bench" }}
    secondaryCTA={{ text: "What it's measured against", href: "#benchmark" }}
    mediaLabel="The contract bench: primitives/button.mz and mz contract"
  >
    <div slot="media" id="bench" class="bench" aria-labelledby="bench-title">
      <div class="bench-head">
        <h2 id="bench-title">primitives/button.mz</h2>
        <p>Change a touch height. The contract answers.</p>
      </div>
      <div class="bench-src" id="bench-src" set:html={benchSrc} />
      <div class="bench-term" id="bench-term" aria-live="polite" set:html={benchTerm} />
      <div class="bench-foot">
        Messages are verbatim from <code>mz contract</code>, checked against a real
        run at <a href={`https://github.com/mzizi-dev/mzizi/blob/${LANG_COMMIT}/primitives/button.mz`}>{LANG_COMMIT}</a>.
        The check is re-implemented in this page's script so you can play with it.
        Each step changes a size's class and its height together (<code>h-12</code>{" "}
        and 48 to <code>h-11</code> and 44): change the height alone and{" "}
        <code>mz check</code> stops first, with MZ0313, because the class still
        renders the old height.{" "}
        <code>0ms</code> is wall-clock time for the contract check alone, rounded
        down to whole milliseconds; reading the file and starting the process are
        not included.
        <button class="bench-reset" id="bench-reset" type="button">Reset</button>
      </div>
    </div>
  </Hero>

  <Section bg="secondary" border id="status">
    <Alert
      variant="warning"
      role="region"
      aria-labelledby="status-title"
      className="status flow text-body p-6 md:p-8"
    >
      <h2 id="status-title">Status: two pilots, no advantage yet</h2>
      <p>
        <strong>Phase 0 has one goal: to build Mzizi as a programming language,
          measured against the best existing language for each kind of
          task</strong>: UI components against Rust (Dioxus, Leptos) and
        TypeScript (React), and backend handlers against TypeScript, Python, Go,
        C++ and Rust{" "}(<a href="#benchmark">below</a>). Nothing has been
        measured against that yet.
      </p>
      <p>
        What exists is the front end of a language whose first domain is UI
        components, in its toolchain: the <code>mz</code> compiler has a lexer, a
        recovering parser, a resolver, an agent diagnostic protocol with{" "}
        <code>mz fix</code> to apply its exact fixes, and a content-addressed IR,
        and nine primitives are written in Mzizi itself. Contract blocks are
        evaluated (see the bench above). The first backend slice is in too: a{" "}
        <code>service</code> with HTTP routes and handlers, which{" "}
        <code>mz contract</code> runs in process and <code>mz build</code> lowers
        to a local Rust + axum package that CI compiles, tests and serves. Since
        the 8 October release (#96), a <code>program</code> computes:{" "}
        <code>mz run</code> checks it, lowers it to a Rust package with no
        dependencies, builds it and runs it (an example is below). No component
        lowers yet, and there is no Workers, Containers or WebAssembly target.
      </p>
      <p>
        <strong>Mzizi is not yet a working programming language.</strong> In a
        program, Mzizi has expressions, bindings, functions, control flow, error
        handling, collections and records with methods, over <code>int</code>,{" "}
        <code>float</code>, <code>bool</code>, <code>text</code> and enums. The
        tracker marks C1–C5 and C7–C10 ✅ on <code>main</code>, and C6 🟡. On main
        it has no modules, standard library or concurrency yet, and text
        operations are only partly built: slicing, search, split and parsing are
        not. <a href={TRACKER}><strong>What still has to be built</strong></a>{" "}
        (<code>LANGUAGE-TRACKER.md</code>) is the one list, stacked against
        Python, Go, C++, TypeScript and Rust, with two milestones: M1, a language
        that computes, and M2, a working programming language. Neither is
        reached: M1 still needs the rest of text operations (C6), which waits on
        the standard library and an owner decision (<a href="#toward-m1">in progress toward M1</a>, below).
      </p>
      <p>
        <strong>The language harness is the spine of the language.</strong> Every
        feature a program has registers an entry in the compiler, and{" "}
        on <code>main</code>, <code>mz harness definition</code> prints them as JSON: 191 entries,
        80 of them diagnostic codes, at <code>4d0cdc3</code> (v0.7.0); 49 codes are pending. Tests enforce that every code the compiler
        can emit has an entry (or, for a component's or a service's codes, is on
        a frozen pending list) and that every entry's examples and triggers still
        do what they say. Each code's <code>say</code> text and each feature's
        teaching text are written by hand and not compared with the checker, and
        the plugin host and the generated skills are not built. Whether an agent
        taught by the harness writes Mzizi more reliably is a hypothesis the
        benchmark is designed to test; nothing has measured it.
      </p>
      <p>
        <strong
          >Two pilot runs on 2026-09-27 show no measurable advantage for Mzizi.</strong
        > They were the first tests inside Phase 0, not its goal: each ported
        registry UI components (a button and a badge were scored) into Mzizi and
        into Rust with Dioxus. With a frontier model, the two arms were
        indistinguishable on clean compiles and defects, and Mzizi used about 8%
        fewer tokens. With a ~7B open-weight model, the size the design targets,
        Mzizi did worse on all three metrics (2 of 6 clean compiles against
        Dioxus's 4 of 6). Both pilots are tiny (pilot 1 ran three tasks with one
        seed; pilot 2 scored two tasks with three seeds), and neither is the
        Phase 0 number.{" "}
        <a href="https://github.com/mzizi-dev/mzizi/blob/main/benchmarks/results/2026-09-27-pilot-2/RUN.md"
          >The write-up</a
        > names the three failure mechanisms and what has to change before a run
        that tests the kill criterion.
      </p>
      <p>
        <strong>Phase 0 is not complete, and the kill-criterion run has not
          happened.</strong> Most of the fixes pilot 2 asked for have landed since:{" "}
        <code>mz fix</code>; diagnostics for the React idioms Mzizi has no form for
        (MZ0106, MZ0312); a declared <code>height</code> that disagrees with its
        class is now a compile error (MZ0313); relative paths in the diagnostics
        an agent reads; a <code>slot_set</code> fact and a <code>card</code> task;
        and a kill-criterion driver that will not start without a pre-registered{" "}
        <code>PLAN.md</code>.{" "}
        <a href="https://github.com/mzizi-dev/mzizi/blob/main/benchmarks/READINESS.md"
          ><code>benchmarks/READINESS.md</code></a
        > audits each one. The runner now reads every arm from{" "}
        <code>arm.toml</code>, hands the <code>ui-spec</code> family a
        language-neutral <code>spec.md</code>, and has a React arm, whose pins
        now come from the registry's lockfile, with the UI guides balanced to
        within 5%. The run still waits on: held-out tasks, in a private
        repository that does not exist yet; the <code>PLAN.md</code> itself; the
        Leptos and React arms run end to end; and, for the backend family, probe
        scoring in the runner, tasks B2–B5 and the other-language arms.
      </p>
      <p>
        <strong>The kill criterion is Mzizi against the best existing language for
          each kind of task</strong>
        (<a href="https://github.com/mzizi-dev/mzizi/blob/main/design/RFC-0009-comparison-benchmark.md"
          >RFC-0009</a
        > §6). The aim is to rank with the top languages, not only to beat Dioxus
        or Leptos. Within a task family, the bar on each of the three metrics is
        the best value any existing language reached, and Mzizi must beat it on
        two of the three, on held-out tasks, with the ~7B model. A win counts only
        when a paired bootstrap's 95% interval for the difference excludes zero.
        Phase 0 passes only if both gating families, UI (<code>ui-spec</code>) and{" "}
        <code>backend</code>, pass. None of that has been measured. If it shows no
        measurable advantage, nothing downstream matters. Treat every claim on
        this site as a design intent with an argument behind it, not a result.
      </p>
      <p>
        Every run is published, whichever way it falls. Each one lands in{" "}
        <a href="https://github.com/mzizi-dev/mzizi/tree/main/benchmarks/results"
          ><code>benchmarks/results/</code></a
        > in <code>mzizi-dev/mzizi</code>, raw episodes included. A held-out run
        publishes its scores on the day; its task texts are published when that
        task set is retired.
      </p>
    </Alert>

