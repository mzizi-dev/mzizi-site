    </div>

    <div class="button-row">
      <a class={buttonVariants({ variant: "primary" })} href="/components#roots"
        >The {rustCount} Roots components</a
      >
      <a class={buttonVariants({ variant: "outline" })} href="/components">Browse all {total}</a>
      <a class={buttonVariants({ variant: "ghost" })} href="/playground">Previews →</a>
      <a class={buttonVariants({ variant: "ghost" })} href="/architecture">The DNA helix →</a>
      <a class={buttonVariants({ variant: "ghost" })} href="/tokens">The tokens →</a>
