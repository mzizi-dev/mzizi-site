---
import { Alert } from "@bundu/ui/ui/alert";
import { Card } from "@bundu/ui/ui/card";
import Site from "../layouts/Site.astro";
import Progress from "../components/Progress.astro";
import ProgramRun from "../components/ProgramRun.astro";
import { numbersProgram, recordsProgram } from "../lib/programs";
import { decisions, DECISIONS_FIRST_HREF, DECISIONS_HREF, M1_ISSUE } from "../lib/progress";

/**
 * The language page. Sourced from `mzizi-dev/mzizi/CHARTER.md` v0.4 (§3
 * design goals, §4 phasing, §5 non-goals, §6 the resolved benchmark design),
 * the RFCs in that repository's `design/` directory (RFC-0009 §6 for the kill
 * criterion), `benchmarks/READINESS.md` for what the gating run waits on, and
 * `LANGUAGE-TRACKER.md` for every capability claim: if a row is not ✅ there,
 * this page does not say Mzizi has it. Where the charter leaves something
 * open, this page says so rather than rounding it up.
 */

const TRACKER = "https://github.com/mzizi-dev/mzizi/blob/main/LANGUAGE-TRACKER.md";
const CHARTER = "https://github.com/mzizi-dev/mzizi/blob/main/CHARTER.md";
// The language commit this page's figures and captured output were read at.
const LANG_COMMIT = "4d0cdc3";
// Captured from `mz build examples/registry.mz --out out/registry` at 4d0cdc3,
// the third 8 October release (#104); re-run at 4d0cdc3 and unchanged.
const buildOutput =
  "mz: built `service registry` into out/registry (3 routes, 1 fixtures); run it with `cargo run --release --manifest-path out/registry/Cargo.toml`";

// LANGUAGE-TRACKER.md at 4d0cdc3, condensed by area. Each mark is the one the
// tracker's Tier 1, Tier 2 and tooling rows give (C1–C10, P1–P11, T1): its
// "Against the languages" table still describes the program slice as an open
// pull request, and the rows are the ones it keeps current.
const tracker = [
  { area: "Expressions, variables, functions, loops", mark: "✅", mzizi: "in a program: int, float, bool and text expressions, let and var, functions and recursion, else when, match, for each over a range, while (C1–C4)" },
  { area: "Error handling", mark: "✅", mzizi: "in a program: result(T, E), return error(e), prefix try and a match on a result (C9); no conversion between error types" },
  { area: "Modules and imports", mark: "❌", mzizi: "one declaration per file" },
  { area: "Standard library", mark: "❌", mzizi: "none" },
  { area: "Numbers", mark: "✅", mzizi: "int (overflow traps) and float (IEEE 754), with the numeric methods; no decimal (C5)" },
  { area: "Text operations", mark: "🟡", mzizi: "in a program: length, contains, starts_with, ends_with, trim, to_upper, to_lower, replace and repeat (C6); no slicing, search, split or parsing, which wait for the standard library and RFC-0013 §20 Q20" },
  { area: "Collections", mark: "✅", mzizi: "in a program: list, map and set with methods, folds, and indexing that returns an option; no tuples, by design (C7)" },
  { area: "User types", mark: "✅", mzizi: "in a program: records with fields, methods, with and always contracts (C8); enums with columns; no traits or generics (P12)" },
  { area: "Compiles to something that runs", mark: "🟡", mzizi: "a service lowers to a local Rust + axum package, which CI compiles, tests and serves; a program lowers to a Rust package with no dependencies, which mz run builds and runs; no component lowers (P3, P4)" },
  { area: "Rust interop, package manager, editor support, concurrency", mark: "❌", mzizi: "none yet" },
  { area: "Diagnostics built for agents", mark: "✅", mzizi: "mz check --agent, mz fix" },
  { area: "Contracts on everything", mark: "✅ 🟡", mzizi: "components ✅; services 🟡, run in process by mz contract, ensure tested over generated requests, not proven" },
];

const goals = [
  {
    name: "Low syntactic ambiguity",
    why: "Every degree of freedom in how a thing could have been written is a degree of freedom a model can get subtly wrong. Fewer distinct-but-equivalent ways to express one intent.",
  },
  {
    name: "Dense, high-signal errors",
    why: "The agentic loop is generate → compile → read error → fix. Its quality is bounded by how much actionable information the compiler packs into each character of output. This is compiler UX aimed at a machine reader.",
  },
  {
    name: "Fast incremental compilation",
    why: "A human tolerates a few seconds per iteration. An agent iterating hundreds of times per session treats compile latency as the dominant cost of the whole workflow — so it is a Phase 0 success metric, not a later optimisation.",
  },
  {
    name: "Everything has a contract",
    why: "Every component, language function, handler, service and standard-library function carries an in-language contract the toolchain checks. A contract may constrain only a value the program renders or returns, never a declared copy of it: pilot 2 caught a touch-height contract checking a number the button does not render.",
  },
  {
    name: "Token-efficient representation",
    why: "A codebase that fits more real logic into a context window per token spent is one an agent can reason about with less summarisation loss. It applies to the syntax surface and to the IR the tooling exposes.",
  },
];

const phases = [
  {
    n: "Phase 0",
    title: "Build Mzizi as a programming language, measured against the best existing language for each kind of task",
    state: "in progress: two pilots, no advantage shown; the gating run has not happened",
    body: "The one goal is to build Mzizi as a programming language. The measure: an agent authors equivalent code in Mzizi and in the best existing language for each kind of task, scored on tokens consumed, iterations to a clean check, and defect rate. Two gating families, on held-out tasks with the ~7B model: UI components (against Rust with Dioxus and Leptos, and TypeScript with React) and backend handlers and services (against TypeScript, Python, Go, C++ and Rust). The two pilots of 2026-09-27, which ported registry UI components into Mzizi and Dioxus, were tests inside this phase, not its goal. If Mzizi shows no measurable advantage, nothing downstream matters.",
  },
  {
    n: "Phase 1",
    title: "Full-stack: mzizi-ui with Cloudflare Workers and Containers",
    state: "not started",
    body: "A Mzizi-authored full-stack application actually deployed to Cloudflare: UI through mzizi-ui, rendered by a compatible engine (Dioxus today), and the server from the same Mzizi source, lowered to workers-rs for a Worker or to a native Rust HTTP server for a Container. Its UI also ships as a self-contained artifact, an ES module or custom element with its WASM bundle, usable without the Worker.",
  },
  {
    n: "Phase 2",
    title: "Candle integration",
    state: "not started",
    body: "ML inference declared as a first-class capability inside a component, backed by Candle. Not a competing tensor runtime.",
  },
  {
    n: "Phase 3",
    title: "Native mobile: interop first",
    state: "not started",
    body: "mzizi-ui rendered through a compatible mobile engine (Dioxus today) first. Generating native Swift, ArkTS or Kotlin from the same Rust core is named but not designed, and needs its own RFC.",
  },
  {
    n: "Phase 4",
    title: "Distribution adapters",
    state: "not started",
    body: "Thin packaging layers over Phase 1's self-contained artifact. Astro with Mzizi Roots underneath is one of the two frontend paths, beside pure Rust, and can ship as soon as that artifact exists.",
  },
  {
    n: "Phase 5",
    title: "Hardware and embedded",
    state: "not designed",
    body: "Named, not designed: no target board, RTOS or use case. Revisited once Phase 1 has a real full-stack deployment.",
  },
];

const rfcs = [
  {
    id: "RFC-0001",
    file: "RFC-0001-syntax.md",
    what: "The nine failure modes an agent hits writing Rust UI code, and the syntax that answers each: end <kind> <name>, one construct per intent, enum data columns, contracts, capabilities, no ownership surface.",
  },
  {
    id: "RFC-0002",
    file: "RFC-0002-runtime-and-prior-art.md",
    what: "The design-target correction — small open-weight models, not frontier ones — and why the runtime is the product. Thirteen languages mined for ideas, with the licence discipline that keeps the tree clean.",
  },
  {
    id: "RFC-0003",
    file: "RFC-0003-ir.md",
    what: "The eight barriers an agent hits reading a codebase, and the content-addressed IR that answers them: incremental compiles, semantic patching, caching and free renames from one decision.",
  },
  {
    id: "RFC-0004",
    file: "RFC-0004-test-topology.md",
    what: "What is public (nearly all the testing) and what is held out (the benchmark task set), why, and the rule that keeps forks working: private consumes public, never the reverse.",
  },
  {
    id: "RFC-0006",
    file: "RFC-0006-contracts.md",
    what: "What a contract block means: the clause grammar, the subject language, and what mz contract proves and deliberately does not. Draft; implemented as mz contract.",
  },
  {
    id: "RFC-0007",
    file: "RFC-0007-gap-register.md",
    what: "Everything the charter's scope needs that the grammar and compiler do not yet provide, checked against the code and ordered by what blocks what. A register, not an implementation.",
  },
  {
    id: "RFC-0008",
    file: "RFC-0008-types-collections-records.md",
    what: "RFC-0007's first tier: name and type resolution, list(T), record, option(T) and for each, and a checker that can say no. Draft.",
  },
  {
    id: "RFC-0009",
    file: "RFC-0009-comparison-benchmark.md",
    what: "The comparison benchmark: every language arm, the task families, per-language checkers, fairness rules, the kill criterion (§6) and publication (§7). Draft; the kill criterion and the publication rule are owner decisions. Its runner steps are partly built (arm.toml, spec.md input, the React and mzizi-be arms); nothing has been measured.",
  },
  {
    id: "RFC-0010",
    file: "RFC-0010-contracts-everywhere.md",
    what: "Contracts everywhere: clause forms for functions, handlers, services and records, what is checked statically, by generated tests or at runtime, and how failures reach an agent. Draft; a service's contracts run in process through RFC-0011, and nothing else in it is implemented.",
  },
  {
    id: "RFC-0011",
    file: "RFC-0011-handlers.md",
    what: "Handlers, the backend measurement slice: a service with HTTP routes and handlers, its checks, running it in process with mz contract, and lowering it to Rust and axum. Draft; the front end, the in-process run and the lowering are built, and nothing has been measured.",
  },
  {
    id: "RFC-0012",
    file: "RFC-0012-harness.md",
    what: "The harness, the core of the language, what the agent reads: the language as an agent reads it, the agent protocol and the plugin host, and how the skills fold in. §8 compares it with seven outside systems (the Language Server Protocol, Roslyn, the TypeScript language service, rustc's JSON output, MCP servers, Unison, Go's analysis framework). Draft for review; the agent protocol, the IR and the language harness's first slice (mz harness, with an entry for every feature a program has) exist today, and the plugin host and generated skills do not.",
  },
  {
    id: "RFC-0013",
    file: "RFC-0013-core-language.md",
    what: "The core language, all of Tier 1: a program file kind, expressions, numbers, bindings, functions, control flow, collections, text, methods on records, errors, mz run and lowering. A draft for review (#76), with its amendments from the language survey (#81). Built, on main since the 8 October release: the program kind, expressions, numbers, bindings, functions, control flow, errors, mz run and their lowering. Collections, text operations and methods on records are design.",
  },
];
// RFC-0009 §1, the arms; each state is benchmarks/arms/ at mzizi-dev/mzizi
// 4d0cdc3. "exists" is a directory there; "not added yet" is proposed by
// RFC-0009 with no directory. scripts/check-facts.py compares this table with
// the live directory listing.
const arms = [
  { id: "mzizi", family: "UI", lang: "Mzizi", state: "exists" },
  { id: "dioxus", family: "UI", lang: "Rust, Dioxus =0.7.10", state: "exists" },
  { id: "leptos", family: "UI", lang: "Rust, Leptos =0.8.21", state: "exists; never run" },
  { id: "react", family: "UI", lang: "TypeScript, React, class-variance-authority (pins from the registry's lockfile)", state: "exists; never run" },
  { id: "mzizi-be", family: "backend", lang: "Mzizi, with the probe crate mzprobe and task B1", state: "exists; never run" },
  { id: "ts", family: "backend", lang: "TypeScript, Hono on Node", state: "not added yet" },
  { id: "python", family: "backend", lang: "Python, FastAPI with pydantic v2, served by uvicorn", state: "not added yet" },
  { id: "go", family: "backend", lang: "Go, net/http from the standard library", state: "not added yet" },
  { id: "cpp", family: "backend", lang: "C++20, cpp-httplib and nlohmann/json", state: "not added yet" },
  { id: "rust", family: "backend", lang: "Rust, axum on tokio, serde", state: "not added yet" },
];
---

<Site
  title="The language"
  description="The Mzizi programming language: general-purpose, with Rust as its platform the way JavaScript is TypeScript's, a harness at its core by design, and the aim of being the language you choose instead of TypeScript, Python or C++."
  lede="A general-purpose programming language, with Rust as its platform the way JavaScript is TypeScript's. Its goal is to be the language you choose instead of TypeScript, Python or C++. It is designed around a harness at its core, the layer an agent reads and works through, and for agents to write, specifically the small open-weight models that need the help most."
>
  <p>
    Mzizi is designed to lower to Rust: Dioxus for UI, and axum or{" "}
    <code>workers-rs</code> for servers. Today two things lower: a{" "}
    <code>service</code>, which <code>mz build</code> turns into a local Rust +
    axum package that CI compiles, tests and serves, and a <code>program</code>,
    which <code>mz run</code> turns into a Rust package with no dependencies,
    builds and runs. No component lowers yet, and there is no Workers,
    Containers or WebAssembly target. The novel part, and
    the only part worth defending as research, is the language itself: its
    syntax, its type system, its contracts, and the feedback loop its
    diagnostics give an agent. At its core is the harness: the layer an agent
    reads and works through. It covers the language as an agent sees it
    (grammar, types, contracts, canonical form), the agent protocol (
    <code>mz check --agent</code>, its diagnostics and fixes; RFC-0001 §4),
    and the plugin host the toolchain, the CLI, the MCP server and plugins
    attach to natively. Part of it exists today, in the toolchain, as{" "}
    <code>mz check --agent</code>'s output and as the language harness's first
    slice, which <code>mz harness</code> prints (below); the harness as a whole
    is designed, not built, in{" "}
    <a href="https://github.com/mzizi-dev/mzizi/blob/main/design/RFC-0012-harness.md"
      >RFC-0012</a
    >, a draft. It lives here, in{" "}
    <code>mzizi-dev/mzizi</code>, and the agent-tools packages (the CLI, the
    MCP server, <code>fundi</code>) are its clients. The <code>mz</code>{" "}
    compiler is the toolchain that implements the language, not the language. Cross-platform rendering is interop
    with Dioxus rather than a rebuilt engine; ML is Candle; the edge target is{" "}
    <code>workers-rs</code>. Reinventing any of those would buy the language
    nothing and would cost Phase 0 its focus.
  </p>

  <Alert variant="warning" role="region" className="status flow text-body p-6">
    <h2>What exists, and what that does not prove</h2>
    <p>
      Real today, in the toolchain: the lexer, a recovering parser, a resolver,
      the agent diagnostic protocol and <code>mz fix</code>, and the
      content-addressed IR, plus nine primitives written in Mzizi itself, covered
      by 744 tests in 27 suites, 613 of them in the compiler crate
      (<code>mzizi-dev/mzizi</code> at{" "}
      <a href={`https://github.com/mzizi-dev/mzizi/commit/${LANG_COMMIT}`}><code>{LANG_COMMIT}</code></a>,{" "}
      <code>main</code> after the third 8 October release, #104, tagged <code>v0.7.0</code>; 33,138 lines in{" "}
      <code>compiler/src</code>, from a fresh count). Nothing is waiting on{" "}
      <code>staging</code>, which holds <code>main</code>'s tree. Blocks nest at most 64
      deep (MZ0411), and robustness tests hold every command to ending with a
      diagnostic on random and deeply nested input.{" "}
      <code>mz contract</code> evaluates contract blocks. A <code>service</code>{" "}
      with HTTP routes and handlers (RFC-0011) is checked by{" "}
      <code>mz check</code>, run in process by <code>mz contract</code>, and
      lowered by <code>mz build</code> to a local Rust + axum package. A{" "}
      <code>program</code> (RFC-0013) computes, with functions, control flow
      and errors as values, and <code>mz run</code> builds and runs it; the
      language harness registers every feature it has. The
      benchmark harness (<code>mzbench</code>) runs agent episodes on the Mzizi,
      Dioxus, Leptos and React arms (Leptos and React never yet run) and scores
      each result against the registry's reference; the Mzizi backend arm,{" "}
      <code>mzizi-be</code>, has its probe crate and a first task, and has never
      run.
    </p>
    <p>
      <strong>Two pilots have run, and neither shows an advantage for Mzizi.</strong>{" "}
      On 2026-09-27 a frontier model scored the same on both arms, with Mzizi about
      8% cheaper in tokens. A ~7B open-weight model, the size the design targets,
      did worse in Mzizi on all three metrics: 2 of 6 clean compiles against 4 of 6.
      Its repair loop resubmitted the same file 15 times out of 16. It also hit
      React idioms Mzizi has no form for, and a variant table that asks for one
      fact twice. Both pilots are tiny, and neither is the charter's measurement.{" "}
      <a
        href="https://github.com/mzizi-dev/mzizi/blob/main/benchmarks/results/2026-09-27-pilot-2/RUN.md"
        >The pilot 2 write-up</a
      > lists what has to change before a run that tests the kill criterion. The five
      design goals below are hypotheses with arguments attached, and so far the
      evidence has not backed them.
    </p>
    <p>
      <strong>Phase 0 is not complete: the kill-criterion run has not
        happened.</strong> Most of pilot 2's fixes are on <code>main</code>:{" "}
      <code>mz fix</code>, diagnostics for <code>...props</code> and{" "}
      <code>asChild</code> (MZ0106, MZ0312), MZ0313 for a declared{" "}
      <code>height</code> that disagrees with its class, relative paths in the
      diagnostics an agent sees, a <code>slot_set</code> fact and a{" "}
      <code>card</code> task, and a kill-criterion driver that needs a
      pre-registered <code>PLAN.md</code>.{" "}
      <a href="https://github.com/mzizi-dev/mzizi/blob/main/benchmarks/READINESS.md"
        ><code>benchmarks/READINESS.md</code></a
      > lists what remains. The React arm's pins now come from the registry's
      lockfile. Still to come: held-out tasks in a private repository, written by maintainers or
      drafted by another vendor's model and reviewed by a person (the owner is to
      confirm which); the <code>PLAN.md</code>; the Leptos and React arms run end
      to end; and, for the backend family, probe scoring in the runner, tasks
      B2–B5 and the other-language backend arms.
    </p>
  </Alert>

  <h2 id="still-to-build">What still has to be built</h2>

  <Card className="flow my-6">
    <p>
      <strong>Mzizi is not yet a working programming language.</strong> In a
      program, Mzizi has expressions, bindings, functions, control flow, error
      handling, collections and records with methods, over <code>int</code>,{" "}
      <code>float</code>, <code>bool</code>, <code>text</code> and enums: the
      tracker marks C1–C5 and C7–C10 ✅ on{" "}
      <code>main</code>, and C6 (text operations) 🟡. On main it has no modules,
      standard library or concurrency yet, and text operations are only partly
      built: slicing, search, split and parsing are not. No component lowers to
      Rust. <a href={TRACKER}><code>LANGUAGE-TRACKER.md</code></a> is the one tracker of
      what it still needs, row by row against Python, Go, C++, TypeScript and
      Rust, each with its evidence and the test that turns it ✅. It is where this
      page takes every capability claim from.
    </p>
    <p>
      <strong>M1, a language that computes:</strong> all of Tier 1 (expressions,
      bindings, functions, control flow, numbers, text, collections, user types,
      error handling, a program that runs). That unblocks the public suites.{" "}
      <strong>M2, a working programming language:</strong> Tier 1 plus modules,
      a standard library, lowering all code to Rust, <code>mz build</code> and{" "}
      <code>mz run</code> for a general program, errors mapped back to{" "}
      <code>.mz</code>, and Rust crate interop. Only at M2 does the tracker say
      Mzizi is a working programming language. Neither milestone is reached.
    </p>
  </Card>

  <h2 id="toward-m1-work">Progress toward M1</h2>

  <p>
    The work toward M1 is tracked in{" "}
    <a href={M1_ISSUE.href}>mzizi-dev/mzizi{M1_ISSUE.label}</a>. It is built
    in waves: first RFC-0013, the design of all of Tier 1, and a foundation
    slice that the later waves extend, then numbers, control flow, errors and
    the first slice of the language harness. All of these reached{" "}
    <code>main</code> in the 8 October release (<a href="https://github.com/mzizi-dev/mzizi/pull/91">#91</a>). The tracker rows that now read ✅ (<a href="https://github.com/mzizi-dev/mzizi/pull/92">#92</a>) and the harness's second slice (<a href="https://github.com/mzizi-dev/mzizi/pull/93">#93</a>) came in the same release, <a href="https://github.com/mzizi-dev/mzizi/pull/96">#96</a>.
    Records and methods (C8) and collections (C7) reached <code>main</code> in the
    third 8 October release, tagged <a href="https://github.com/mzizi-dev/mzizi/releases/tag/v0.7.0">v0.7.0</a> (<a href="https://github.com/mzizi-dev/mzizi/pull/104">#104</a>, with{" "}
    <a href="https://github.com/mzizi-dev/mzizi/pull/101">#101</a>, <a href="https://github.com/mzizi-dev/mzizi/pull/102">#102</a> and{" "}
    <a href="https://github.com/mzizi-dev/mzizi/pull/99">#99</a>), and text methods (C6, <a href="https://github.com/mzizi-dev/mzizi/pull/98">#98</a>) partly so.
    What M1 still needs is the rest of text operations, which waits on the standard
    library and an owner decision. No pull request toward M1 is open on 8 October;
    #105, a docs fix after v0.7.0 that changes no mark, is on staging. Anything in the third column below is not merged, and Mzizi does not
    have it.
  </p>

  <Progress />

  <h3>The owner's decisions, 2026-10-07</h3>

  <p>
    From the tracking issue's{" "}
    <a href={DECISIONS_FIRST_HREF}>first</a> and{" "}
    <a href={DECISIONS_HREF}>second</a> rounds of decisions, as decided, not
    as built:
  </p>

  <ul class="spaced">
    {decisions.map((d) => <li>{d}</li>)}
  </ul>

  <p>
    <strong>One informal timing, not a benchmark.</strong>{" "}
    <a href={DECISIONS_HREF}>The issue records</a> <code>fib(40)</code> timed
    on one 4-core virtual machine, about five runs each, with high noise: Rust
    in release mode about 390 ms, Rust with overflow checks on about 690 ms,
    and the program the foundation slice lowers from Mzizi about 730 ms. On
    that machine Mzizi was slower than Rust's default, and about level with
    Rust under the same overflow checks. It is context for the overflow
    decision above, not a result. The performance suite has since landed on{" "}
    <code>main</code> (<a href="https://github.com/mzizi-dev/mzizi/pull/85">#85</a>,
    in the 8 October release) with no timing committed.
  </p>

  <div class="scroller">
    <table>
      <thead>
        <tr>
          <th scope="col">Area</th>
          <th scope="col">Mzizi today</th>
        </tr>
      </thead>
      <tbody>
        {
          tracker.map((t) => (
            <tr>
              <th scope="row">{t.area}</th>
              <td>
                {t.mark} {t.mzizi}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p>
    <a href={TRACKER}>What still has to be built: the full tracker →</a>
  </p>

  <h2>What "built for machine authorship" cashes out as</h2>

  <p>
    The charter insists this be measurable design goals rather than a slogan.
    There are five.
  </p>

  <div class="scroller">
    <table>
      <thead>
        <tr>
          <th scope="col">Goal</th>
          <th scope="col">Why it is on the list</th>
        </tr>
      </thead>
      <tbody>
        {
          goals.map((g) => (
            <tr>
              <th scope="row">{g.name}</th>
              <td>{g.why}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>How the benchmark is defined</h2>

  <Card className="flow my-6">
    <p>
      <strong>Kill criterion</strong>
      (<a href="https://github.com/mzizi-dev/mzizi/blob/main/design/RFC-0009-comparison-benchmark.md"
        >RFC-0009</a
      > §6, owner decision 2026-09-29): Mzizi against the best existing language
      for each kind of task. Within a gating family (<code>ui-spec</code> or{" "}
      <code>backend</code>), the bar on each metric is the best value any
      existing language reached. Mzizi must beat it on two of the three metrics,
      on held-out tasks, with the ~7B open-weight model. A win counts only when a
      paired bootstrap's 95% interval for the difference excludes zero. Phase 0
      passes only if both families pass.
    </p>
    <p>
      <strong>Task families</strong> (RFC-0009 §2), never pooled:{" "}
      <code>ui-spec</code> restates UI components as a language-neutral{" "}
      <code>spec.md</code>, so no arm is handed code in its own language, and{" "}
      <code>backend</code> is HTTP handlers and services, grounded in the API
      gateway and scored by HTTP probes. Both gate, on held-out tasks. Mzizi's
      own components are the ground truth for the public UI tasks.{" "}
      <code>ui-port</code>, porting a React <code>spec.tsx</code> as both pilots
      did, is for development and comparison with the pilots only, and the public
      suites (MultiPL-E, EvalPlus, Aider polyglot, BaxBench) give comparability
      with the field and never gate.
    </p>
    <p>
      <strong>Defect:</strong> code that checks cleanly but is behaviourally wrong
      — it passes its check and fails a fact against the reference (a UI fact, or
      an HTTP probe for a backend task). A
      syntax or compile error is not a defect for this metric; it is the ordinary
      friction the error-density goal exists to reduce. The metric measures what gets{" "}
      <em>past</em> the compiler wrong.
    </p>
    <p>
      <strong>Visibility:</strong> the harness is public — runner, metric definitions,
      scoring code, fixture format. The held-out task set and its expected outputs
      are not: they are to live in a separate private repository, which has not
      been created yet. That is a measurement-validity
      requirement rather than a secrecy preference: a public task set gets scraped
      into training data, after which the benchmark measures memorisation, a contaminated
      benchmark looks like a successful one, and the kill criterion could never fire.
    </p>
    <p>
      <strong>Publication</strong> (RFC-0009 §7): every run is published,
      whichever way it falls, with a <code>PLAN.md</code> committed before the
      first episode and a <code>RUN.md</code> after. A held-out run publishes its
      scores on the day; its task texts are published when that task set is
      retired.
    </p>
  </Card>

