{
  "name": "@bundu/mzizi-site",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "mzizi.dev — the front door to the Mzizi ecosystem, and the agent-facing surfaces that describe it.",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check && vp check",
    "deploy": "pnpm run build && wrangler deploy",
    "generate:previews": "node scripts/generate-previews.mjs",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test --passWithNoTests",
    "ci:prepare": "astro sync"
  },
  "devDependencies": {
    "@astrojs/check": ">=0.9.12",
    "@tailwindcss/vite": ">=4.3.4",
    "@types/react": ">=19.3.0",
    "@types/react-dom": ">=19.3.0",
    "astro": ">=7.4.5",
    "marked": ">=18.1.3",
    "pagefind": ">=1.6.0",
    "playwright": ">=1.64.1",
    "tailwindcss": ">=4.3.4",
    "typescript": ">=6.0.3 <7",
    "vite-plus": ">=1.4.0",
    "wrangler": ">=4.156.2"
  },
  "dependencies": {
    "@astrojs/react": ">=7.1.2",
    "@bundu/ui": ">=0.12.0 <1",
    "react": ">=19.3.1",
    "react-dom": ">=19.3.1"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.9.4",
      "fast-uri": ">=3.1.9",
      "http-cache-semantics@<4.3.0": ">=4.3.0",
      "sharp": ">=0.35.5",
      "smol-toml": ">=1.9.1",
      "source-map-js": ">=1.2.2",
      "undici": ">=7.30.1",
      "vite": ">=8.3.5",
      "zod@<4.6.6": ">=4.6.6"
    }
  }
}
