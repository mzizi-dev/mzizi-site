{
  "name": "@bundu/mzizi-site",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "mzizi.dev — the front door to the Mzizi ecosystem, and the agent-facing surfaces that describe it.",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check && vp check",
    "deploy": "pnpm run build && wrangler deploy",
    "generate:previews": "node scripts/generate-previews.mjs",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test --passWithNoTests",
    "ci:prepare": "astro sync"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.2.9",
    "marked": "^16.4.2",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite-plus": "^1.0.0",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@bundu/ui": "^0.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
