{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mzizi-site",
  "compatibility_date": "2026-05-22",

  // A site is a Worker with Static Assets — the shape every other Bundu
  // surface takes. There is no `main`: Astro emits the HTML and the asset
  // server is all the routing it needs, so this Worker has no code of its own.
  "assets": {
    "directory": "./dist",
    // Not `single-page-application`. This is a multi-page static site with no
    // client-side router, so an unknown path SHOULD 404 rather than be
    // rewritten to the landing page — a soft 404 that renders the homepage is
    // worse than a real one for both crawlers and agents.
    "not_found_handling": "404-page",
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // ---------------------------------------------------------------------
  // NO ROUTES HERE — BUT THIS WORKER SERVES `mzizi.dev` ANYWAY.
  // ---------------------------------------------------------------------
  //
  // Read that twice. It is not a contradiction, it is the defect.
  //
  // This block used to say that mzizi.dev was served by
  // `mzizi-dev/mzizi-registry` on Vercel and that adding a custom domain here
  // would take the apex away from it. Measured 2026-09-12, that has already
  // happened: `curl -sSI https://mzizi.dev` returns `server: cloudflare` with
  // no `x-vercel-id` and no `x-powered-by: Next.js`, the apex title is this
  // site's, and `https://mzizi.dev/llms.txt` is byte-identical to
  // `public/llms.txt` in this repository.
  //
  // The custom domain was attached to this Worker in the CLOUDFLARE DASHBOARD,
  // not from this file. Nothing in this repository routes anything. So:
  //
  //   * `wrangler deploy` from here is a PRODUCTION deploy to mzizi.dev.
  //   * The route cannot be reviewed, reverted or diffed in version control.
  //   * The registry surfaces the apex used to serve — /components, /tokens,
  //     /brand, /architecture, /observability, /r/, /api/v1, /mcp — now 404 on
  //     mzizi.dev. The API and the MCP server survived on api.mzizi.dev and
  //     mcp.mzizi.dev; the developer portal did not move anywhere and has no
  //     live address.
  //
  // The cutover runbook (mzizi-site#3) and the pull request that ports the
  // displaced pages here (mzizi-site#5) are both still OPEN, and
  // mzizi-registry#334, which would have made the route reviewable, was CLOSED
  // unmerged. README.md records the full sequence.
  //
  // WHEN the route is finally written down here, it takes a BARE HOSTNAME:
  //
  //     "routes": [{ "pattern": "mzizi.dev", "custom_domain": true }]
  //
  // Never `"mzizi.dev/*"`. Wildcards are rejected outright ("Wildcard
  // operators (*) are not allowed in Custom Domains"), and a custom domain
  // already routes every path on the hostname here, so a `/*` is both invalid
  // and redundant. `zone_name` is inferred and only means anything on a
  // non-custom-domain route.
  //
  // This is not a style note. The three-field form silently broke two Workers
  // in this org — mzizi-mcp (agent-tools#102) and mzizi-console, which never
  // deployed at all — because Workers Builds previews upload a version WITHOUT
  // applying routes. The config is only validated on the PRODUCTION deploy, so
  // the same commit reads green on a pull request and red on main.
}
